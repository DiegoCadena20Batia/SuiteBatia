<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BatiaSuite.Controls"
    x:Class="BatiaSuite.Controls.BordererPicker">

    <Frame
        Style="{StaticResource FrameStyle}"
        Padding="{OnPlatform Android=5, iOS=15}">

        <controls:TransparentPicker
            x:Name="transparentPicker"
            Title="{Binding Title}"
            ItemsSource="{Binding ItemsSource}"
            SelectedItem="{Binding SelectedItem}"
            TextColor="Black"
            TitleColor="{StaticResource Gray}"
            FontSize="{OnIdiom 16, Tablet=20}" />
    </Frame>
</ContentView>
