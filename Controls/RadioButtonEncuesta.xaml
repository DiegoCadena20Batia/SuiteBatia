<?xml version="1.0" encoding="utf-8" ?>
<RadioButton
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:BatiaSuite.Converters"
    x:Class="BatiaSuite.Controls.RadioButtonEncuesta"
    BackgroundColor="{OnPlatform Android=Transparent, iOS={AppThemeBinding Light=Transparent, Dark='#DDD'}}"
    TextColor="Black"
    FontSize="{OnIdiom 16, Tablet=18}"
    FontFamily="OpenSansRegular"
    x:Name="radioButton">

    <RadioButton.Resources>
        <ResourceDictionary>
            <converters:MultiBindingConverter
                x:Key="MultiBindingConverter" />
        </ResourceDictionary>
    </RadioButton.Resources>
    
    <RadioButton.Behaviors>
        <toolkit:EventToCommandBehavior
            EventName="CheckedChanged"
            Command="{Binding CheckedChangedCommand}">            
            <toolkit:EventToCommandBehavior.CommandParameter>
                <MultiBinding
                    Converter="{StaticResource MultiBindingConverter}">
                    <Binding
                        Path="IsChecked"
                        Source="{x:Reference radioButton}" />
                    <Binding
                        Path="GroupName"
                        Source="{x:Reference radioButton}" />
                    <Binding
                        Path="Value"
                        Source="{x:Reference radioButton}" />
                </MultiBinding>
            </toolkit:EventToCommandBehavior.CommandParameter>
        </toolkit:EventToCommandBehavior>
    </RadioButton.Behaviors>
</RadioButton>
