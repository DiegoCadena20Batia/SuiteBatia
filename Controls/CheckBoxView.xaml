<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="BatiaSuite.Controls.CheckBoxView">

    <Frame
        Style="{StaticResource FrameStyle}"
        Padding="{OnIdiom '10, 5, 5, 5', Tablet=13}">

        <Grid
            ColumnDefinitions="*, auto">

            <Label
                Text="{Binding Text}"
                Style="{StaticResource LabelStyleBase}"
                TextColor="{Binding IsChecked, Converter={StaticResource BoolToColorConverter}}"
                FontSize="{OnIdiom 16, Tablet=20}"
                VerticalOptions="Center" />

            <CheckBox
                Grid.Column="1"
                IsChecked="{Binding IsChecked}">

                <CheckBox.Behaviors>
                    <toolkit:EventToCommandBehavior
                        EventName="CheckedChanged"
                        Command="{Binding Command}"
                        CommandParameter="{Binding CommandParameter}" />
                </CheckBox.Behaviors>
            </CheckBox>
        </Grid>
    </Frame>
</ContentView>