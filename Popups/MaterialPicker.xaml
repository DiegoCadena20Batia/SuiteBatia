<?xml version="1.0" encoding="utf-8" ?>
<mopup:PopupPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mopup="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:const="clr-namespace:BatiaSuite.Utils"
    x:Class="BatiaSuite.Popups.MaterialPicker"
    BackgroundColor="{StaticResource BackgroundPopup}"
    Style="{StaticResource PopupStyle}">

    <Frame
        Style="{StaticResource PopupFrameStyle}">

        <Grid
            RowDefinitions="auto, *, auto"
            ColumnDefinitions="*, auto">

            <Entry
                x:Name="searchEntry"
                Placeholder="{x:Static const:Constants.BUSCAR_MATERIAL}"
                ReturnCommand="{Binding GetMaterialListCommand}"
                ReturnCommandParameter="{Binding Source={x:Reference searchEntry}, Path=Text}"
                Margin="{OnIdiom '10, 10, 0, 0', Tablet='20, 20, 0, 10'}" />

            <ImageButton
                Grid.Column="1"
                Style="{StaticResource ImageButtonIconStyle}"
                Source="{StaticResource SearchIcon}"
                Command="{Binding GetMaterialListCommand}"
                CommandParameter="{Binding Source={x:Reference searchEntry}, Path=Text}"
                Margin="{OnIdiom '10, 10, 10, 2', Tablet='20, 20, 20, 12'}" />

            <CollectionView
                Grid.Row="1"
                Grid.ColumnSpan="2"
                x:Name="stackCollection"
                ItemsSource="{Binding MaterialList}"
                Margin="{OnPlatform Android={OnIdiom Phone='10,0', Tablet='20,0'}, iOS={OnIdiom Phone='10, 10, 10, 0', Tablet='20, 20, 20, 0'}}"
                VerticalScrollBarVisibility="Never">

                <CollectionView.EmptyView>
                    <Label
                        Text="{Binding EmptyView}"
                        VerticalTextAlignment="Start"
                        HorizontalTextAlignment="Center"
                        TextColor="Gray"
                        FontSize="{OnIdiom 14, Tablet=20}"
                        Margin="20, 100" />
                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Padding="{OnIdiom '10', Tablet='15'}"
                            Style="{StaticResource FrameStyle}">

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    NumberOfTapsRequired="1"
                                    Command="{Binding Source={x:Reference stackCollection}, Path=BindingContext.SelectMaterialCommand}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>

                            <Grid
                                RowDefinitions="auto, auto, auto, auto"
                                RowSpacing="5">

                                <Label
                                    Text="{Binding Clave}"
                                    Style="{StaticResource ContentLabelStyle}" />

                                <Label
                                    Grid.Row="1"
                                    Text="{Binding Descripcion}"
                                    Style="{StaticResource ContentLabelStyle}"
                                    FontAttributes="Bold" />

                                <Label
                                    Grid.Row="2"
                                    Text="{Binding Unidad,StringFormat='Unidad : {0}'}"
                                    Style="{StaticResource ContentLabelStyle}" />

                                <Grid
                                    Grid.Row="3"
                                    RowDefinitions="auto"
                                    ColumnDefinitions="*, auto"
                                    IsVisible="{Binding Source={x:Reference stackCollection}, Path=BindingContext.IdAlmacen, Converter={StaticResource IntToBoolConverter}}">

                                    <Label
                                        Text="{Binding CostoUnitario,StringFormat='Costo : {0:C2}'}"
                                        Style="{StaticResource ContentLabelStyle}" />

                                    <Label
                                        Grid.Column="1"
                                        HorizontalOptions="End"
                                        Text="{Binding Existencia, StringFormat='Existencia : {0}'}"
                                        Style="{StaticResource ContentLabelStyle}" />
                                </Grid>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator
                Grid.Row="1"
                Grid.ColumnSpan="2"
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Style="{StaticResource LoadingPopupStyle}"
                Margin="0, 30"/>

            <Button
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Text="{x:Static const:Constants.CANCELAR}"
                Command="{Binding CancelCommand}"
                Style="{StaticResource ButtonPopupStyle}" />
        </Grid>
    </Frame>
</mopup:PopupPage>