<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:controls="clr-namespace:BatiaSuite.Controls"
    xmlns:const="clr-namespace:BatiaSuite.Utils"
    x:Class="BatiaSuite.Popups.MatSumClientePopup"
    BackgroundColor="{StaticResource BackgroundPopup}"
    Style="{StaticResource PopupStyle}">

    <Frame
        Style="{StaticResource PopupFrameStyle}"
        VerticalOptions="CenterAndExpand"
        BorderColor="{Binding  BorderColor}">

        <Grid
            RowDefinitions="auto, auto">

            <Grid
                RowDefinitions="auto, auto, auto, auto, auto"
                ColumnDefinitions="*, *"
                Padding="10">

                <Label
                    Grid.ColumnSpan="2"
                    Text="{x:Static const:Constants.SUMINISTRADOS_CLIENTE}"
                    Style="{StaticResource ContentBoldLabelStyle}"
                    Margin="10,10,10,20"
                    HorizontalTextAlignment="Center" />

                <controls:BordererEntry
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Placeholder="{x:Static const:Constants.DESCRIPCION}"
                    Text="{Binding Descripcion, Mode=TwoWay}"
                    Margin="0,0,0,20"
                    ReturnType="Next" />

                <controls:BordererEntry
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Text="{Binding Cantidad, Mode=TwoWay}"
                    Placeholder="{x:Static const:Constants.INGRESE_CANTIDAD}"
                    Keyboard="Numeric"
                    Margin="0, 0, 0, 20"
                    ReturnType="Next" />

                <controls:BordererPicker
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    ItemsSource="{Binding UnidadMedidaList}"
                    ItemDisplayBinding="Descripcion"
                    SelectedItem="{Binding SelectedUnidadMedida}"
                    Title="{x:Static const:Constants.SELECCIONE_UNIDAD}"
                    Margin="0, 0, 0, 20" />

                <Button
                    Grid.Row="4"
                    Text="{x:Static const:Constants.CANCELAR}"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource ButtonPopupStyle}" />

                <Button
                    Grid.Row="4"
                    Grid.Column="1"
                    Text="{x:Static const:Constants.ACEPTAR}"
                    Command="{Binding AcceptCommand}"
                    Style="{StaticResource ButtonPopupStyle}" />
            </Grid>

            <Grid
                Grid.Row="2"
                ColumnDefinitions="*, auto"
                Padding="10, 0"
                Margin="0"
                BackgroundColor="Red"
                IsVisible="{Binding ShowError}">

                <Label
                    Text="{Binding ErrorMesage}"
                    TextColor="White"
                    FontSize="{OnIdiom 12, Tablet=18}"
                    FontFamily=""
                    FontAttributes="Bold"
                    VerticalTextAlignment="Center" />

                <ImageButton
                    Grid.Column="1"
                    Source="{StaticResource CancelIcon}"
                    WidthRequest="{OnIdiom 20, Tablet=22}"
                    Scale="{OnPlatform Android=1, iOS=.6}"
                    Command="{Binding CloseErrorCommand}" />
            </Grid>
        </Grid>
    </Frame>
</mopups:PopupPage>