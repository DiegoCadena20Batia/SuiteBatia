		<!-- DECLARACIÓN OBLIGATORIA DEL SERVICIO EN PRIMER PLANO -->
		<!-- Reemplaza .Services.TuServicioNombre por la ruta exacta de la clase de tu servicio -->
		<service android:name=".Services.TuServicioNombre" android:enabled="true" android:exported="false" android:foregroundServiceType="location|mediaPlayback" />
	</application>
</manifest>