<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:const="clr-namespace:BatiaSuite.Utils"
    xmlns:viewModel="clr-namespace:BatiaSuite.ViewModel.OrdenesTrabajo"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:controls="clr-namespace:BatiaSuite.Controls"
    x:Class="BatiaSuite.Views.OrdenesTrabajo.ManoObra"
    Title="{Binding Title}"
    Style="{StaticResource PageStyle}"
    x:Name="ManoObraPage"
    Shell.FlyoutBehavior="Disabled">

    <Grid>
        <ScrollView
        Padding="{OnIdiom '0, 0, 0, 70', Tablet='0, 0, 0, 105'}">

            <Grid
            Margin="10,0"
            RowDefinitions="auto, auto, auto, auto, auto">

                <!-- ========== TARJETA DEL SERVICIO ========== -->
                <Border
                Margin="5"
                Padding="{OnIdiom 15, Tablet=20}"
                BackgroundColor="White"
                Stroke="LightBlue"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 15">

                    <Grid RowDefinitions="auto, auto, auto, auto, auto, auto">

                        <Label
                        Text="{Binding Cliente}"
                        Style="{StaticResource ContentLabelStyle}"
                        FontSize="16"
                        FontFamily="MontSemibold" />

                        <Label
                        Grid.Row="1"
                        Text="{Binding Inmueble}"
                        Style="{StaticResource ContentLabelStyle}"
                        FontSize="14"
                        TextColor="{StaticResource AzulClaro}" />

                        <BoxView
                        Grid.Row="2"
                        HeightRequest="1"
                        Margin="0,1,52,0"
                        Color="LightGray" />

                        <Label
                        Grid.Row="3"
                        Margin="0,5"
                        Text="{Binding Tipo, StringFormat='Tipo: {0}'}"
                        Style="{StaticResource ContentLabelStyle}" />

                        <Border
                        Grid.Row="4"
                        Margin="0,10,0,0"
                        Padding="15"
                        BackgroundColor="#f5f5f5"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 15">

                            <ScrollView MaximumHeightRequest="300">
                                <VerticalStackLayout>
                                    <Label
                                    Text="Descripción:"
                                    Style="{StaticResource ContentLabelStyle}"
                                    TextColor="{StaticResource AzulClaro}" />

                                    <Label
                                    Text="{Binding DescripcionTrabajos}"
                                    Style="{StaticResource ContentLabelStyle}" />
                                </VerticalStackLayout>
                            </ScrollView>
                        </Border>

                        <Label
                        Grid.Row="5"
                        Margin="0,10,0,0"
                        HorizontalOptions="End"
                        Text="{Binding Falta}" />
                    </Grid>
                </Border>

                <!-- ========== TRABAJOS REALIZADOS ========== -->
                <Label
                Grid.Row="1"
                Margin="5,10,0,10"
                Text="Ingrese los trabajos realizados:"
                Style="{StaticResource ContentBoldLabelStyle}"
                FontSize="17"
                TextColor="Black" />

                <controls:BordererEditor
                Grid.Row="2"
                Text="{Binding Descripcion}" />

                <!-- ========== PERSONAL ========== -->
                <Grid
                Grid.Row="3"
                Margin="10,20,10,0"
                RowDefinitions="auto, auto"
                ColumnDefinitions="*, auto">

                    <Label
                    Text="Agregar personal"
                    Style="{StaticResource ContentBoldLabelStyle}"
                    FontSize="17"
                    TextColor="Black" />

                    <ImageButton
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Source="{StaticResource GreenPlusIcon}"
                    Style="{StaticResource ImageButtonIconStyle}"
                    Command="{Binding AgregarPersonalCommand}" />

                    <BoxView
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    HeightRequest="2"
                    Margin="0,5,0,0"
                    Color="LightGray" />
                </Grid>

                <VerticalStackLayout
                Grid.Row="4"
                BindableLayout.ItemsSource="{Binding SelectedPersonalList}"
                Spacing="10"
                Margin="0,10,0,0">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItem
                                    BackgroundColor="Red"
                                    Text="{x:Static const:Constants.QUITAR}"
                                    Invoked="OnQuitarInvoked"
                                    CommandParameter="{Binding Source={x:Reference ManoObraPage}, Path=BindingContext.EliminarEmpleadoSeleccionadoCommand}" />
                                </SwipeView.RightItems>

                                <Border
                                Style="{StaticResource BorderStyle}"
                                StrokeShape="RoundRectangle 15"
                                Padding="{OnIdiom 15, Tablet=20}">

                                    <Grid
                                    ColumnDefinitions="*, auto"
                                    RowDefinitions="auto, auto">

                                        <Label
                                        Margin="0,0,10,0"
                                        Text="{Binding Nombre}"
                                        Style="{StaticResource ContentLabelStyle}"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation" />

                                        <Label
                                        Grid.Column="1"
                                        Text="{Binding IdEmpleado}"
                                        Style="{StaticResource ContentLabelStyle}"
                                        HorizontalOptions="End"
                                        VerticalTextAlignment="Center" />

                                        <Label
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Text="{Binding Horas, StringFormat='Horas trabajadas: {0}'}"
                                        Style="{StaticResource ContentLabelStyle}" />
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <ImageButton
        Source="{StaticResource ArrowIcon}"
        Style="{StaticResource FloatingButtonStyle}"
        Command="{Binding ContinuarCommand}" />

        <!-- ========== OVERLAY DE CARGA ========== -->
        <Grid
        RowDefinitions="*, *"
        BackgroundColor="#88000000"
        IsVisible="{Binding IsLoading, FallbackValue=False}">

            <ActivityIndicator
            VerticalOptions="End"
            Color="White"
            IsRunning="{Binding IsLoading, FallbackValue=False}"
            HeightRequest="{OnIdiom 70, Tablet=120}" />

            <Label
            Grid.Row="1"
            VerticalOptions="Start"
            HorizontalOptions="Center"
            TextColor="White"
            Text="{Binding TextLoading}" />
        </Grid>
    </Grid>
</ContentPage>