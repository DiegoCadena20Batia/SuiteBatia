<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:const="clr-namespace:BatiaSuite.Utils"
    xmlns:viewModel="clr-namespace:BatiaSuite.ViewModel.OrdenesTrabajo"
    x:Class="BatiaSuite.Views.OrdenesTrabajo.MaterialesUtilizados"
    Style="{StaticResource PageStyle}"
    Title="{x:Static const:Constants.MATERIALES_UTILIZADOS}"
    Shell.FlyoutBehavior="Disabled">

    <ContentPage.BindingContext>
        <viewModel:MaterialesUtilizadosViewModel />
    </ContentPage.BindingContext>

    <Grid>

        <ScrollView
            Padding="{OnIdiom '0, 0, 0, 70', Tablet='0, 0, 0, 105'}">

            <Grid
                RowDefinitions="auto, auto, auto, auto, auto, auto, auto,auto,auto,auto,auto"
                ColumnDefinitions="*, auto"
                Padding="10,0">

                <Label
                    Text="{x:Static const:Constants.SUMINISTRADOS_CLIENTE}"
                    Style="{StaticResource ContentBoldLabelStyle}"
                    TextColor="Black"
                    FontSize="17"/>

                <ImageButton
                    Grid.Column="1"
                    Style="{StaticResource ImageButtonIconStyle}"
                    Source="{StaticResource GreenPlusIcon}"
                    Command="{Binding AddMatSumClienteCommand}" />
                <Label
                    Grid.Row="1"
                    HeightRequest="2"
                    VerticalOptions="End"
                    Margin="0,0,0,0"
                    BackgroundColor="LightGray"
                ></Label>
                <VerticalStackLayout
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    BindableLayout.ItemsSource="{Binding MatSumClienteList}"
                    Spacing="10"
                    Margin="0,10,0,20"
                    x:Name="stackSumnistradosCliente">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItem
                                        BackgroundColor="Red"
                                        Text="{x:Static const:Constants.QUITAR}"
                                        Command="{Binding Source={x:Reference stackSumnistradosCliente}, Path=BindingContext.RemoveMatSumClienteCommand}"
                                        CommandParameter="{Binding .}" />
                                </SwipeView.RightItems>
                                <Frame
                                    CornerRadius="20"
                                    Padding="{OnIdiom 15, Tablet=20}"
                                    Style="{StaticResource FrameStyle}">

                                    <Grid
                                        RowDefinitions="*, *"
                                        ColumnDefinitions="auto, *"
                                        ColumnSpacing="10">

                                        <Label
                                            Text="{Binding Descripcion}"
                                            Style="{StaticResource ContentLabelStyle}"
                                            FontAttributes="Bold"
                                            Grid.ColumnSpan="2" />

                                        <Label
                                            Grid.Row="1"
                                            Text="{Binding Cantidad, StringFormat='Cantidad : {0}'}"
                                            Style="{StaticResource ContentLabelStyle}" />

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Text="{Binding Unidad.Descripcion}"
                                            Style="{StaticResource ContentLabelStyle}" />
                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Grid
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    RowDefinitions="auto, auto,auto"
                    ColumnDefinitions="*, auto"
                    Margin="0,0,0,30">

                    <Label
                        Text="{x:Static const:Constants.BUSCAR_ALMACEN}"
                        Style="{StaticResource ContentBoldLabelStyle}"
                        TextColor="Black"
                        FontSize="17"  />

                    <ImageButton
                        Grid.Column="1"
                        Style="{StaticResource ImageButtonIconStyle}"
                        Source="{StaticResource SearchIcon}"
                        Command="{Binding GetAlmacenCommand}" />
                    <Label
                        Grid.Row="1"
                        HeightRequest="2"
                        VerticalOptions="End"
                        Margin="0,0,0,0"
                        BackgroundColor="LightGray"
                    ></Label>
                    <Frame
                        CornerRadius="20"
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource FrameStyle}"
                        Margin="0,10,0,0">

                        <Label
                            Text="{Binding Almacen.Nombre}"
                            Style="{StaticResource ContentLabelStyle}"
                            FontAttributes="Bold">
                            
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    NumberOfTapsRequired="1"
                                    Command="{Binding GetAlmacenCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Frame>
                </Grid>

                <Label
                    Margin="0,0,0,0"
                    Grid.Row="4"
                    Text="{x:Static const:Constants.SUMINISTRADOS_ALMACEN}"
                    Style="{StaticResource ContentBoldLabelStyle}"
                    TextColor="Black"
                    FontSize="17" />

                <ImageButton
                    Grid.Row="4"
                    Grid.Column="1"
                    Style="{StaticResource ImageButtonIconStyle}"
                    Source="{StaticResource GreenPlusIcon}"
                    Command="{Binding AddMatSumAlmacenCommand}"
                    Margin="0,0,0,0" />
                <Label
                    Grid.Row="5"
                    HeightRequest="2"
                    VerticalOptions="End"
                    Margin="0,0,0,0"
                    BackgroundColor="LightGray"
                ></Label>
                <VerticalStackLayout
                    Grid.Row="6"
                    Grid.ColumnSpan="2"
                    BindableLayout.ItemsSource="{Binding MatSumAlmacenList}"
                    Spacing="10"
                    Margin="0,10,0,20">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItem
                                        BackgroundColor="Red"
                                        Text="{x:Static const:Constants.QUITAR}"
                                        Command="{Binding Source={x:Reference stackSumnistradosCliente}, Path=BindingContext.RemoveMatSumAlmacenCommand}"
                                        CommandParameter="{Binding .}" />
                                </SwipeView.RightItems>
                                <Frame
                                    CornerRadius="20"
                                    Padding="{OnIdiom 15, Tablet=20}"
                                    Style="{StaticResource FrameStyle}">

                                    <Grid
                                        RowDefinitions="*, *, *, *">

                                        <HorizontalStackLayout
                                            Spacing="20">

                                            <Label
                                                Text="{Binding Clave}"
                                                Style="{StaticResource ContentLabelStyle}"
                                                TextColor="{StaticResource AzulClaro}"/>

                                            <Label
                                                Text="{Binding Descripcion}"
                                                Style="{StaticResource ContentLabelStyle}"
                                                LineBreakMode="TailTruncation"
                                                FontAttributes="Bold" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout
                                            Grid.Row="1"
                                            Spacing="20">

                                            <Label
                                                Text="{Binding CantidadUsada, StringFormat='Cantidad : {0}'}"
                                                Style="{StaticResource ContentLabelStyle}" />

                                            <Label
                                                Text="{Binding Unidad}"
                                                Style="{StaticResource ContentLabelStyle}" />
                                        </HorizontalStackLayout>

                                        <Label
                                            Grid.Row="2"
                                            Text="{Binding CostoUnitario, StringFormat='Costo unitario : {0:C2}'}"
                                            Style="{StaticResource ContentLabelStyle}" />

                                        <Grid
                                            Grid.Row="3"
                                            ColumnDefinitions="*, auto">

                                            <Label
                                                Text="{Binding CantidadXCobrar, StringFormat='Cantidad a cobrar: {0}'}"
                                                Style="{StaticResource ContentLabelStyle}" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding CostoXCobrar, StringFormat='Costo: {0:C2}'}"
                                                Style="{StaticResource ContentLabelStyle}" />
                                        </Grid>
                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label
                    Grid.Row="7"
                    Text="{x:Static const:Constants.SUMINISTRADOS_COMPRA}"
                    Style="{StaticResource ContentBoldLabelStyle}"
                    TextColor="Black"
                    FontSize="17"  />

                <ImageButton
                    Grid.Row="7"
                    Grid.Column="1"
                    Style="{StaticResource ImageButtonIconStyle}"
                    Source="{StaticResource GreenPlusIcon}"
                    Command="{Binding AddMatSumCompraCommand}"
                    Margin="0,0,0,0" />
                <Label
                    Grid.Row="7"
                    HeightRequest="2"
                    VerticalOptions="End"
                    Margin="0,0,0,0"
                    BackgroundColor="LightGray"
                ></Label>
                <VerticalStackLayout
                    Grid.Row="8"
                    Grid.ColumnSpan="2"
                    BindableLayout.ItemsSource="{Binding MatSumCompraList}"
                    Spacing="10"
                    Margin="0,10,0,0">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItem
                                        BackgroundColor="Red"
                                        Text="{x:Static const:Constants.QUITAR}"
                                        Command="{Binding Source={x:Reference stackSumnistradosCliente}, Path=BindingContext.RemoveMatSumCompraCommand}"
                                        CommandParameter="{Binding .}" />
                                </SwipeView.RightItems>
                                <Frame
                                    CornerRadius="20"
                                    Padding="{OnIdiom 15, Tablet=20}"
                                    Style="{StaticResource FrameStyle}">

                                    <Grid
                                        RowDefinitions="*, *, *, *">

                                        <HorizontalStackLayout
                                            Spacing="20">

                                            <Label
                                                Text="{Binding Clave}"
                                                Style="{StaticResource ContentLabelStyle}"
                                                TextColor="{StaticResource AzulClaro}"/>

                                            <Label
                                                Text="{Binding Descripcion}"
                                                Style="{StaticResource ContentLabelStyle}"
                                                FontAttributes="Bold"
                                                LineBreakMode="TailTruncation" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout
                                            Grid.Row="1"
                                            Spacing="20">

                                            <Label
                                                Text="{Binding CantidadUsada, StringFormat='Cantidad comprada : {0}'}"
                                                Style="{StaticResource ContentLabelStyle}" />

                                            <Label
                                                Text="{Binding Unidad}"
                                                Style="{StaticResource ContentLabelStyle}" />
                                        </HorizontalStackLayout>

                                        <Label
                                            Grid.Row="2"
                                            Text="{Binding CostoUnitario, StringFormat='Costo unitario : {0:C2}'}"
                                            Style="{StaticResource ContentLabelStyle}" />

                                        <Grid
                                            Grid.Row="3"
                                            ColumnDefinitions="*, auto">

                                            <Label
                                                Text="{Binding CantUtilizada, StringFormat='Cantidad utilizada: {0}'}"
                                                Style="{StaticResource ContentLabelStyle}" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Total, StringFormat='Total: {0:C2}'}"
                                                Style="{StaticResource ContentLabelStyle}" />
                                        </Grid>
                                    </Grid>
                                </Frame>
                            </SwipeView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <ImageButton
            Source="{StaticResource ArrowIcon}"
            Style="{StaticResource FloatingButtonStyle}"
            Command="{Binding NextPageCommand}" />
        <Grid
    Grid.RowSpan="3"
    RowDefinitions="*,*"
    BackgroundColor="#88000000"
    IsVisible="{Binding IsLoading}">
            <ActivityIndicator
        Grid.Row="0"
        VerticalOptions="End"
        Color="White"
        IsRunning="{Binding IsLoading}"
        HeightRequest="{OnIdiom 70, Tablet=120}"/>
            <Label
         VerticalOptions="Start"
         HorizontalOptions="Center"
         Grid.Row="1"
         TextColor="White"
         Text="{Binding TextLoading}"
    ></Label>
        </Grid>
    </Grid>
</ContentPage>