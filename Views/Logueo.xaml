<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="BatiaSuite.Views.Logueo"
    xmlns:controls="clr-namespace:BatiaSuite.Controls"
    Title=""
      BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#121212}">
    <ScrollView VerticalOptions="Fill">
        <Grid VerticalOptions="Center"
          RowDefinitions="auto, auto, auto, auto, auto, auto"
          Margin="25,0"
          RowSpacing="15">

            <!-- Header: Logo + Título -->
            <VerticalStackLayout Grid.Row="0"
                             HorizontalOptions="Center"
                             Spacing="10"
                             Margin="0,10,0,10">

                <Image Source="logosuitebatia.png"
                   HeightRequest="120"
                   HorizontalOptions="Center" />

                <Label FontSize="32"
                   FontAttributes="Bold"
                   FontFamily="MontSemibold"
                   HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="SUITE " TextColor="{AppThemeBinding Light={StaticResource AzulOscuro}, Dark=#60A5FA}" />
                            <Span Text="BATIA" TextColor="{AppThemeBinding Light={StaticResource AzulClaro}, Dark=#93C5FD}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>

            <!-- Subtítulo Iniciar Sesión -->
            <Label Grid.Row="1"
               Text="INICIAR SESIÓN"
               FontSize="15"
               FontFamily="MontBold"
               TextColor="{AppThemeBinding Light=Black, Dark=#F8FAFC}"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Center"
               Margin="0,0,0,5" />

            <!-- Campo Usuario -->
            <Frame Grid.Row="2"
               CornerRadius="15"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
               Padding="12,5"
               BorderColor="{AppThemeBinding Light=LightGray, Dark=#334155}">

                <Grid ColumnDefinitions="auto, *" VerticalOptions="Center">
                    <Image Source="userr.png"
                       HeightRequest="24"
                       WidthRequest="24"
                       VerticalOptions="Center" />

                    <controls:TransparentEntry Grid.Column="1"
                                            TextColor="{AppThemeBinding Light={StaticResource AzulClaro}, Dark=#FFFFFF}"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource DarkGray}, Dark=#94A3B8}"
                                            VerticalOptions="Center"
                                            Placeholder="Usuario"
                                            FontSize="16"
                                            FontFamily="MontRegular"
                                            Keyboard="Email"
                                            Text="{Binding UserName}"
                                            ReturnType="Next"
                                            Margin="10,0,0,0" />
                </Grid>
            </Frame>

            <!-- Campo Contraseña -->
            <Frame Grid.Row="3"
               CornerRadius="15"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
               Padding="12,5"
               BorderColor="{AppThemeBinding Light=LightGray, Dark=#334155}">

                <Grid ColumnDefinitions="auto, *, auto" VerticalOptions="Center">
                    <Image Source="lockk.png"
                       HeightRequest="24"
                       WidthRequest="24"
                       VerticalOptions="Center" />

                    <controls:TransparentEntry Grid.Column="1"
                                            TextColor="{AppThemeBinding Light={StaticResource AzulClaro}, Dark=#FFFFFF}"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource DarkGray}, Dark=#94A3B8}"
                                            VerticalOptions="Center"
                                            Placeholder="Contraseña"
                                            FontFamily="MontRegular"
                                            FontSize="16"
                                            IsPassword="{Binding IsPassword}"
                                            Text="{Binding Password}"
                                            Margin="10,0,0,0" />

                    <ImageButton Grid.Column="2"
                             Source="{Binding IconPass}"
                             Command="{Binding ShowPasswordCommand}"
                             WidthRequest="24"
                             HeightRequest="24"
                             BackgroundColor="Transparent"
                             VerticalOptions="Center" />
                </Grid>
            </Frame>

            <!-- Botón de Acción / Indicador de Carga -->
            <Grid Grid.Row="4" Margin="0,10,0,0" VerticalOptions="Center">
                <Button Text="INGRESAR"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    FontFamily="MontSemibold"
                    Command="{Binding LoginCommand}"
                    FontSize="16"
                    TextColor="White"
                    CornerRadius="10"
                    Background="{AppThemeBinding Light=#2E3192, Dark=#3B82F6}"
                    HeightRequest="50"
                    HorizontalOptions="Fill" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HeightRequest="40"
                               WidthRequest="40"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="{AppThemeBinding Light={StaticResource AzulClaro}, Dark=#60A5FA}" />
            </Grid>

            <!-- Sección Registrarse -->
            <HorizontalStackLayout Grid.Row="5"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="0,15,0,0"
                               Spacing="5">

                <Label Text="¿No tienes una cuenta?"
                   TextColor="{AppThemeBinding Light=Black, Dark=#CBD5E1}"
                   FontSize="15"
                   VerticalOptions="Center" />

                <Label Text="Regístrate"
                   TextColor="{AppThemeBinding Light={StaticResource AzulClaro}, Dark=#60A5FA}"
                   FontSize="15"
                   FontAttributes="Bold"
                   VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenRegisterPageCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>