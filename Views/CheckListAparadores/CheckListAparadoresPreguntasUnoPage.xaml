<controls:MasterPage
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:views="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BatiaSuite.Controls"
    xmlns:myConverters="clr-namespace:BatiaSuite.Converters"
    xmlns:utils="clr-namespace:BatiaSuite.Utils"
    x:Class="BatiaSuite.Views.CheckListAparadores.CheckListAparadoresPreguntasUnoPage"
    MasterPageTitle="CHECKLIST DE APARADORES"
    Shell.FlyoutBehavior="Disabled"
    BackgroundColor="#f0f0f0"
    ShowFloatingButton="False">

    <controls:MasterPage.MasterPageContent>
        <Grid  x:Name="mainGrid">
            <Grid RowDefinitions="auto, *,auto">
                <Frame
         Margin="10,0,10,2"
         BackgroundColor="#2e3192"
         Grid.Row="0"
         CornerRadius="15">
                    <Label
             BackgroundColor="Transparent"
             Text="DEPARTAMENTO: VESTIR"
             TextColor="White"
             FontSize="18">
                    </Label>
                </Frame>

                <!-- TÍTULO DE SECCIÓN -->
                <!--
     <Label Grid.Row="1"
            Text="VESTIR"
            TextColor="Black"
            FontSize="18"
            Margin="0,10,0,0"
            HorizontalOptions="Center" />-->

                <!-- HEADER DE TABLA -->
                <Grid Grid.Row="1"
           RowDefinitions="Auto, *,auto">

                    <!-- Header fijo -->
                    <Frame Grid.Row="0"
                Padding="0"
                Margin="20,0,20,0"
                BackgroundColor="#f0f0f0"
                BorderColor="Transparent"
                CornerRadius="0">

                        <Grid Padding="15,10"
                   ColumnDefinitions="*, Auto, Auto">

                            <Label Grid.Column="0"
                        Text="Línea"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#666"/>

                            <Label Grid.Column="1"
                        Text="Aparador 1"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#666"
                        HorizontalOptions="Center"
                        WidthRequest="100"/>

                            <Label Grid.Column="2"
                        Text="Aparador 2"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#666"
                        HorizontalOptions="Center"
                        WidthRequest="100"/>
                        </Grid>
                    </Frame>

                    <!-- LISTA DE PREGUNTAS -->
                    <!--<ScrollView Grid.Row="1">-->
                        <Grid
                            Grid.Row="1"
                            BackgroundColor="Transparent"
                            RowDefinitions="auto,auto">
                            <Grid
                                BackgroundColor="Transparent"
                                Grid.Row="0">
                                <CollectionView ItemsSource="{Binding Preguntas}"
                                                HeightRequest="350"
                                    Margin="20,0,20,20"
                                    VerticalScrollBarVisibility="Never"
                                    HorizontalScrollBarVisibility="Never"
                                    RemainingItemsThreshold="5">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Frame Padding="0" 
                                Margin="0,1" 
                                BorderColor="#ddd" 
                                BackgroundColor="White" 
                                CornerRadius="10">

                                                <Grid Padding="15,0"
                                   ColumnDefinitions="*, Auto, Auto">

                                                    <!-- PREGUNTA -->
                                                    <Label Grid.Column="0"
                                        Text="{Binding Pregunta}"
                                        FontSize="14"
                                        VerticalOptions="Center"
                                        LineBreakMode="WordWrap"/>

                                                    <!-- APARADOR 1 -->
                                                    <Entry Grid.Column="1"
                                        x:Name="entrada1"
                                        Keyboard="Numeric"
                                        IsVisible="False"
                                        Text="{Binding Valor1, Mode=TwoWay}"
                                        WidthRequest="80"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        BackgroundColor="#f8f9fa"
                                        HeightRequest="40"/>

                                                    <!-- APARADOR 2 -->
                                                    <Entry Grid.Column="2"
                                        x:Name="entrada2"
                                        Keyboard="Numeric"
                                        IsVisible="False"
                                        Text="{Binding Valor2, Mode=TwoWay}"
                                        WidthRequest="80"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        BackgroundColor="#f8f9fa"
                                        ClearButtonVisibility="WhileEditing"
                                        HeightRequest="40"/>

                                                    <!-- CHECKBOX 1 (para secciones 4,5) -->
                                                    <CheckBox Grid.Column="1"
                                           x:Name="check1"
                                           IsVisible="False"
                                           IsChecked="{Binding Valor1, Converter={StaticResource IntToBoolConverter}, Mode=TwoWay}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>

                                                    <!-- CHECKBOX 2 (para secciones 4,5) -->
                                                    <CheckBox Grid.Column="2"
                                           x:Name="check2"
                                           IsVisible="False"
                                           IsChecked="{Binding Valor2, Converter={StaticResource IntToBoolConverter}, Mode=TwoWay}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>

                                                </Grid>

                                                <!-- TRIGGERS DEPENDIENDO DE IdSeccion -->
                                                <Frame.Triggers>

                                                    <!-- Secciones 1, 2, 3 → ENTRY -->
                                                    <DataTrigger TargetType="Frame" Binding="{Binding IdSeccion}" Value="1">
                                                        <Setter TargetName="entrada1" Property="IsVisible" Value="True" />
                                                        <Setter TargetName="entrada2" Property="IsVisible" Value="True" />
                                                    </DataTrigger>

                                                    <DataTrigger TargetType="Frame" Binding="{Binding IdSeccion}" Value="2">
                                                        <Setter TargetName="entrada1" Property="IsVisible" Value="True" />
                                                        <Setter TargetName="entrada2" Property="IsVisible" Value="True" />
                                                    </DataTrigger>

                                                    <DataTrigger TargetType="Frame" Binding="{Binding IdSeccion}" Value="3">
                                                        <Setter TargetName="entrada1" Property="IsVisible" Value="True" />
                                                        <Setter TargetName="entrada2" Property="IsVisible" Value="True" />
                                                    </DataTrigger>

                                                    <!-- Secciones 4 y 5 → CHECKBOX -->
                                                    <DataTrigger TargetType="Frame" Binding="{Binding IdSeccion}" Value="4">
                                                        <Setter TargetName="check1" Property="IsVisible" Value="True" />
                                                        <Setter TargetName="check2" Property="IsVisible" Value="True" />
                                                    </DataTrigger>

                                                    <DataTrigger TargetType="Frame" Binding="{Binding IdSeccion}" Value="5">
                                                        <Setter TargetName="check1" Property="IsVisible" Value="True" />
                                                        <Setter TargetName="check2" Property="IsVisible" Value="True" />
                                                    </DataTrigger>

                                                </Frame.Triggers>

                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>

                                </CollectionView>
                            </Grid>
                            <Grid 
                                Margin="20,0,20,20"
                                RowDefinitions="auto,auto,auto"
                                HeightRequest="250"
                                Grid.Row="1">
                                <Button
                                    Margin="10,0,10,10"
                                    HorizontalOptions="Start"
                                    HeightRequest="50"
                                    WidthRequest="240"
                                    Text="{x:Static utils:Constants.CAPTURAR_FOTOGRAFIAS}"
                                    TextColor="White"
                                    BackgroundColor="DodgerBlue"
                                    Grid.Row="0"
                                    ImageSource="camera.png"
                                    ContentLayout="left, 10"
                                    Command="{Binding TakePhotoCommand}"
                                    ></Button>

                                <Frame
                                    HeightRequest="120"
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Padding="0"
                                    BorderColor="White"
                                    BackgroundColor="White">

                                    <ScrollView
                                        Margin="0"
                                        Orientation="Horizontal"
                                        BackgroundColor="White">

                                        <HorizontalStackLayout
                                            BindableLayout.ItemsSource="{Binding PhotoList}"
                                            Spacing="10">


                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Border
                                                            BackgroundColor="White"
                                                            Stroke="Transparent"
                                                            StrokeThickness="0"
                                                            Padding="0"
                                                            StrokeShape="RoundRectangle 10">
                                                            <Border.Shadow>
                                                                <Shadow
                                                                    Brush="Black"
                                                                    Offset="2,2"
                                                                    Opacity="0.2"
                                                                    Radius="4" />
                                                            </Border.Shadow>
                                                            <Image
                                                                Source="{Binding .}"
                                                                Aspect="AspectFit"
                                                                WidthRequest="{OnIdiom 100, Tablet=130}"
                                                                Margin="{OnIdiom '0, 10, 0, 10', Tablet='10, 15, 15, 20'}" />
                                                        </Border>

                                                        <Border
                                                            BackgroundColor="Red"
                                                            Opacity="0.7"
                                                            Stroke="Black"
                                                            StrokeThickness="0"
                                                            HorizontalOptions="End"
                                                            VerticalOptions="Start"
                                                            Margin="0"
                                                            Padding="6"
                                                            StrokeShape="RoundRectangle 10">
                                                            <Border.Shadow>
                                                                <Shadow
                                                                    Brush="Black"
                                                                    Offset="2,2"
                                                                    Opacity="0.2"
                                                                    Radius="4" />
                                                            </Border.Shadow>
                                                            <ImageButton
                                                                Style="{StaticResource ImageButtonIconStyle}"
                                                                Source="{StaticResource TrashIconWhite}"
                                                                Command="{Binding Source={x:Reference mainGrid}, Path=BindingContext.RemovePhotoCommand}"
                                                                CommandParameter="{Binding .}"
                                                                WidthRequest="{OnIdiom 10, Tablet=30}"
                                                                HeightRequest="{OnIdiom 10, Tablet=30}"
                                                                BackgroundColor="Transparent"
                                                                HorizontalOptions="Center"
                                                                VerticalOptions="Center" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                    </ScrollView>
                                </Frame>
                            </Grid>

                        </Grid>


                    <!--</ScrollView>-->

                </Grid>
                <Button
         Margin="20,0,20,0"
         Grid.Row="2"
         BackgroundColor="#2e3192"
         TextColor="White"
         FontSize="18"
         Text="Continuar"
         Command="{Binding ContinuarCommand}" />

            </Grid>
            <Grid
            BackgroundColor="#88000000"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            IsVisible="{Binding IsLoading}">

                <ActivityIndicator
                Color="{StaticResource AzulOscuro}"
                IsRunning="{Binding IsLoading}"
                HeightRequest="{OnIdiom 70, Tablet=120}" />
            </Grid>
        </Grid>
       


    </controls:MasterPage.MasterPageContent>
</controls:MasterPage>