<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:icons="clr-namespace:BatiaSuite.Resources.IconFonts;assembly=BatiaSuite"
    x:Class="BatiaSuite.Views.ListadoMateriales"
    Title="Detalle de Materiales"
    BackgroundColor="#F8F9FA"
    Shell.FlyoutBehavior="Disabled">

    <Grid RowDefinitions="*, Auto">

        <CollectionView
            Grid.Row="0"
            x:Name="lisApp"
            ItemsSource="{Binding ListMateriales}"
            Margin="16,10,16,0">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="10" Margin="0,10,0,16">
                    <Label
                        Text="{Binding ClienteInmueble}"
                        FontFamily="MontBold"
                        FontSize="22"
                        TextColor="#1A3B60" />

                    <Label
                        Text="{Binding FolioEntry, StringFormat='Folio Listado: {0}'}"
                        FontFamily="MontSemibold"
                        FontSize="14"
                        TextColor="#3775B5" />

                    <Border 
                        StrokeShape="RoundRectangle 8"
                        StrokeThickness="0"
                        BackgroundColor="#1A3B60"
                        HeightRequest="40"
                        Padding="12,0"
                        Margin="0,8,0,0">
                        <Grid ColumnDefinitions="*, 80, 90" ColumnSpacing="10" VerticalOptions="Center">
                            <Label
                                Text="PRODUCTO"
                                FontSize="13"
                                TextColor="White"
                                VerticalOptions="Center"
                                FontFamily="MontSemibold" />
                            <Label
                                Grid.Column="1"
                                Text="CANTIDAD"
                                FontSize="13"
                                TextColor="White"
                                HorizontalTextAlignment="Center"
                                VerticalOptions="Center"
                                FontFamily="MontSemibold" />
                            <Label
                                Grid.Column="2"
                                Text="RECIBIDO"
                                FontSize="13"
                                TextColor="White"
                                HorizontalTextAlignment="Center"
                                VerticalOptions="Center"
                                FontFamily="MontSemibold" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border 
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="1"
                        Stroke="#E9ECEF"
                        BackgroundColor="White"
                        Padding="12,14">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.04" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="*, 80, 90" ColumnSpacing="10" VerticalOptions="Center">

                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label
                                    Text="{Binding Producto}"
                                    FontSize="12"
                                    TextColor="#212529"
                                    FontFamily="MontSemibold"
                                    LineBreakMode="WordWrap" />
                                <Label
                                    Text="{Binding Clave}"
                                    FontSize="12"
                                    TextColor="#6C757D"
                                    FontFamily="MontRegular" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="{Binding Cantidad}"
                                FontSize="13"
                                TextColor="#1A3B60"
                                HorizontalTextAlignment="Center"
                                VerticalOptions="Center"
                                FontFamily="MontBold" />

                            <Border
                                Grid.Column="2"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="1"
                                Stroke="#CDEBFF"
                                BackgroundColor="#EEF9FF"
                                HeightRequest="40"
                                WidthRequest="70"
                                HorizontalOptions="Center"
                                Padding="4,0">
                                <Entry
                                    FontSize="13"
                                    TextColor="#1A3B60"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    FontFamily="MontBold"
                                    Text="{Binding Entregado, Mode=TwoWay}"
                                    Keyboard="Numeric" />
                            </Border>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border 
            Grid.Row="1"
            StrokeShape="RoundRectangle 24,24,0,0"
            StrokeThickness="0"
            BackgroundColor="White"
            Padding="20,16,20,24">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-4" Radius="10" Opacity="0.06" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="14">

                <Grid ColumnDefinitions="*, *" ColumnSpacing="12" VerticalOptions="CenterAndExpand">
                    <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="CenterAndExpand" Grid.ColumnSpan="2">
                        <Label Text="Nombre de quien recibe" FontSize="12" FontFamily="MontSemibold" TextColor="#495057" Margin="4,0"/>
                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#CED4DA" Padding="10,0" HeightRequest="48">
                            <Entry
                                FontFamily="MontRegular"
                                FontSize="14"
                                TextColor="#212529"
                                Text="{Binding NombreRecibe}"
                                Placeholder="Ej. Ing. Carlos"
                                PlaceholderColor="#ADB5BD" />
                        </Border>
                    </VerticalStackLayout>

                    <!--<VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="EndAndExpand">
                        <Label Text="Bidones Recuperados" FontSize="12" FontFamily="MontSemibold" TextColor="#495057" Margin="4,0"/>
                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#CED4DA" Padding="10,0" HeightRequest="48">
                            <Entry
                                FontFamily="MontRegular"
                                FontSize="14"
                                TextColor="#212529"
                                Keyboard="Numeric"
                                Text="{Binding Bidones}"
                                Placeholder="Cantidad"
                                PlaceholderColor="#ADB5BD" />
                        </Border>
                    </VerticalStackLayout>-->
                </Grid>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Comentarios (Opcional)" FontSize="12" FontFamily="MontSemibold" TextColor="#495057" Margin="4,0"/>
                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#CED4DA" Padding="10,0" HeightRequest="48">
                        <Entry
                            FontFamily="MontRegular"
                            FontSize="14"
                            TextColor="#212529"
                            Text="{Binding Comentarios}"
                            Placeholder="Observaciones sobre la entrega..."
                            PlaceholderColor="#ADB5BD" />
                    </Border>
                </VerticalStackLayout>

                <Button
                    Margin="0,8,0,0"
                    HeightRequest="52"
                    Text="CONTINUAR A FIRMA"
                    TextColor="White"
                    BackgroundColor="#4A92FE"
                    FontSize="16"
                    FontFamily="MontBold"
                    CornerRadius="12"
                    Command="{Binding GuardarDatosCommand}">
                    <Button.Shadow>
                        <Shadow Brush="#4A92FE" Offset="0,4" Radius="6" Opacity="0.2" />
                    </Button.Shadow>
                </Button>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>