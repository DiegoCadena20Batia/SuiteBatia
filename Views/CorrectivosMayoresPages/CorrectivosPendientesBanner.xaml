<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="BatiaSuite.Views.CorrectivosMayoresPages.CorrectivosPendientesBanner">

    <Frame
        IsVisible="{Binding HayCorrectivosPendientes}"
        BackgroundColor="#FFF3CD"
        BorderColor="#FFEEBA"
        CornerRadius="10"
        Padding="12"
        Margin="10">

        <VerticalStackLayout Spacing="10">

            <Label
                Text="{Binding CantidadCorrectivosPendientes, StringFormat='Tienes {0} correctivo(s) pendiente(s) por enviar'}"
                FontAttributes="Bold"
                TextColor="#856404"
                FontSize="16" />

            <Button
                Text="Enviar ahora"
                Command="{Binding SincronizarCorrectivosCommand}"
                BackgroundColor="#28A745"
                TextColor="White"
                CornerRadius="8" />

        </VerticalStackLayout>

    </Frame>

</ContentView>