<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
             x:Class="BatiaSuite.Views.DiarioLimpieza.DiarioLimpiezaPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="Diario de Limpieza">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="HeaderLabelStyle" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*">

        <ScrollView Grid.Row="0" BackgroundColor="#F5F5F5">
            <VerticalStackLayout Padding="15" Spacing="15">

                <Frame CornerRadius="8" HasShadow="True" BorderColor="Transparent" Padding="15">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="INFORMACIÓN DE SUPERVISIÓN" FontAttributes="Bold" FontSize="16" TextColor="#2196F3"/>
                        <BoxView HeightRequest="1" Color="#E0E0E0" />

                        <Label Text="Seleccionar Sucursal:" FontAttributes="Bold" />
                        <Picker Title="-- Seleccione una Tienda --"
                                ItemsSource="{Binding ListaInmuebles}"
                                ItemDisplayBinding="{Binding Nombre}"
                                SelectedItem="{Binding InmuebleSeleccionado}" />

                        <Label Text="Nombre del Gerente de Tienda:" FontAttributes="Bold" />
                        <Entry Text="{Binding GerenteNombre}" Placeholder="Ingresa el nombre del gerente" />
                    </VerticalStackLayout>
                </Frame>

                <Frame CornerRadius="8" HasShadow="True" BorderColor="Transparent" Padding="0">
                    <Grid RowDefinitions="Auto, *">

                        <Grid Grid.Row="0" BackgroundColor="#2196F3" HeightRequest="40" Padding="5"
                              ColumnDefinitions="2*, 2*, 1.5*, 1.2*">
                            <Label Grid.Column="0" Text="Frecuencia" Style="{StaticResource HeaderLabelStyle}"/>
                            <Label Grid.Column="1" Text="Actividad Específica" Style="{StaticResource HeaderLabelStyle}"/>
                            <Label Grid.Column="2" Text="Personal Asignado" Style="{StaticResource HeaderLabelStyle}"/>
                            <Label Grid.Column="3" Text="Cumple" Style="{StaticResource HeaderLabelStyle}"/>
                        </Grid>

                        <CollectionView Grid.Row="1" ItemsSource="{Binding TareasLimpieza}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="2*, 2*, 1.5*, 1.2*" Padding="5" HeightRequest="65">
                                        <Label Grid.Column="0" Text="{Binding Frecuencia}" 
                                               VerticalOptions="Center" HorizontalOptions="Center" FontSize="12"/>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding ActividadEspecifica}" FontSize="12" LineBreakMode="WordWrap" MaxLines="2" FontAttributes="Bold"/>
                                            <Label Text="{Binding Area}" FontSize="10" TextColor="Gray"/>
                                        </VerticalStackLayout>

                                        <Entry Grid.Column="2" Text="{Binding NombrePersonalAsignado}" 
                                               Placeholder="Nombre" FontSize="11" VerticalOptions="Center"/>

                                        <CheckBox Grid.Column="3" IsChecked="{Binding Cumple}" 
                                                  HorizontalOptions="Center" VerticalOptions="Center" Color="#2196F3"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Frame>

                <Frame CornerRadius="8" HasShadow="True" BorderColor="Transparent" Padding="15">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="FillAndExpand">
                        <Label Text="EVIDENCIAS FOTOGRÁFICAS" FontAttributes="Bold" FontSize="16" TextColor="#2196F3"/>
                        <BoxView HeightRequest="1" Color="#E0E0E0" />

                        <Label Text="{Binding ConteoFotos}" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#555"/>

                        <Button Text="Tomar Fotografía" 
                                Command="{Binding TomarFotoCommand}"
                                ImageSource="camera_icon.png"
                                BackgroundColor="#4CAF50" TextColor="White" CornerRadius="5"/>
                    </VerticalStackLayout>
                </Frame>

                <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{AppThemeBinding Light='#E0E0E0', Dark='#2D2D2D'}" BackgroundColor="{AppThemeBinding Light='#FAFAFA', Dark='#2A2A2A'}" Padding="10">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="GERENTE" FontAttributes="Bold" FontSize="11" TextColor="#2196F3" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Limpiar" Clicked="OnBtnLimpiarGerenteClicked" FontSize="10" HeightRequest="26" Padding="5,0" BackgroundColor="#FF5252" TextColor="White" />
                        </Grid>
                        <views:DrawingView x:Name="PadGerente"
                                           HeightRequest="110"
                                           LineWidth="3"
                                           LineColor="Black"
                                           DrawingLineCompleted="PadGerente_DrawingLineCompleted"
                                           BackgroundColor="{AppThemeBinding Light='White', Dark='#1E1E1E'}" />
                        <BoxView HeightRequest="1" Color="Gray" Margin="0,2,0,0" />
                        <Label Text="FIRMA" FontSize="10" HorizontalOptions="Center" TextColor="Gray" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="ENVIAR CHECKLIST DIARIO" 
                        Command="{Binding EnviarChecklistCommand}"
                        BackgroundColor="#2196F3" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        HeightRequest="50" 
                        CornerRadius="8"
                        Margin="0, 10, 0, 10"/>

            </VerticalStackLayout>
        </ScrollView>

        <Grid BackgroundColor="#80000000" IsVisible="{Binding IsLoading}">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                <ActivityIndicator IsRunning="{Binding IsLoading}" Color="White" HeightRequest="50" WidthRequest="50"/>
                <Label Text="Procesando datos..." TextColor="White" FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>