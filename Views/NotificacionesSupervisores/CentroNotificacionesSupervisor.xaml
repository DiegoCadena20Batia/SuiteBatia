<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BatiaSuite.Views.NotificacionesSupervisores.CentroNotificacionesSupervisor"
            Title="Centro de Notificaciones"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <!-- El BindingContext ya lo asignas desde el Code-Behind C#, por lo que aquí no hace falta definirlo -->

    <Grid RowDefinitions="*">

        <!-- Lista de Empleados que Faltaron -->
        <CollectionView ItemsSource="{Binding EmpleadosQueFaltaron}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- Tarjeta moderna para cada falta de empleado -->
                    <Border StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#2C2C2C}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                            Margin="0,0,0,12"
                            Padding="15">

                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, *">

                            <!-- Icono o indicador visual visual de Alerta -->
                            <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                   Text="❌"
                                   FontSize="24"
                                   Margin="0,0,15,0"
                                   VerticalOptions="Center" />

                            <!-- Nombre del Empleado -->
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Nombre}"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light=#212121, Dark=#FFFFFF}" />

                            <!-- ID / Número de Empleado -->
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding IdEmpleado, StringFormat='ID Empleado: {0}'}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"
                                   Margin="0,4,0,0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Vista vacía por si la lista de faltas viene en cero -->
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                    <Label Text="📭" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="No tienes notificaciones por el momento." TextColor="Gray" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Indicador de carga flotante mientras consulta el API -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="#2196F3"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           WidthRequest="50"
                           HeightRequest="50" />
    </Grid>
</ContentPage>