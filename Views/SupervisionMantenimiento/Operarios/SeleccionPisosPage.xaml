<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BatiaSuite.Views.SupervisionMantenimiento.Operarios.SeleccionPisosPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:BatiaSuite.Models.SupervisionMantenimiento.Operarios"
             Title="Selección de Pisos / Áreas"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#121212}">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- Detalle de la Orden de Trabajo -->
        <Border Grid.Row="0" 
        Margin="12,10" 
        Padding="16" 
        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" 
        Stroke="{AppThemeBinding Light=#E1E4E8, Dark=#2D3748}" 
        StrokeThickness="1">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14"/>
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="8">
                <!-- Cliente e ID -->
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                        <Label Text="{Binding Orden.idCliente, StringFormat='CLIENTE: {0}'}" 
                       FontSize="11" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#586069, Dark=#A0AEC0}"/>

                        <Label Text="{Binding Orden.cliente}" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#1A202C, Dark=#F7FAFC}" 
                       LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>

                    <!-- Badge ID Orden -->
                    <Border Grid.Column="1" 
                    BackgroundColor="{AppThemeBinding Light=#F1F8FF, Dark=#1A2A3A}" 
                    Stroke="{AppThemeBinding Light=#C8E1FF, Dark=#2B4C7E}" 
                    StrokeThickness="1" 
                    Padding="8,4" 
                    VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>

                        <Label Text="{Binding Orden.idOrden, StringFormat='#{0}'}" 
                       FontAttributes="Bold" 
                       FontSize="13" 
                       TextColor="{AppThemeBinding Light=#0366D6, Dark=#63B3ED}"/>
                    </Border>
                </Grid>

                <!-- Sucursal y Coordenadas -->
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="6">
                    <Label Grid.Column="0" Text="📍" FontSize="13" VerticalOptions="Start"/>
                    <Label Grid.Column="1" 
                   Text="{Binding Orden.sucursal}" 
                   FontSize="13"  
                   TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" 
                   LineBreakMode="WordWrap"/>
                </Grid>

                <!-- Pie de Cabecera: Tipo de Orden y Fecha -->
                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,4,0,0">
                    <!-- Badge Tipo Mantenimiento -->
                    <Border Grid.Column="0" 
                    BackgroundColor="{AppThemeBinding Light=#EBF8FF, Dark=#1A2E3B}" 
                    Stroke="{AppThemeBinding Light=#BEE3F8, Dark=#2C5282}" 
                    Padding="8,3">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>

                        <Label Text="{Binding Orden.tipomanto}" 
                       FontSize="11" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#2B6CB0, Dark=#63B3ED}"/>
                    </Border>

                    <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                        <Label Text="📅" FontSize="11" VerticalOptions="Center"/>
                        <Label Text="{Binding Orden.falta}" 
                       FontSize="12" 
                       TextColor="{AppThemeBinding Light=#718096, Dark=#A0AEC0}" 
                       VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>


        <!-- Formulario para Agregar Piso -->
        <Border Grid.Row="1" 
        Margin="12,0,12,10" 
        Padding="6,2" 
        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" 
        Stroke="{AppThemeBinding Light=#CBD5E0, Dark=#2D3748}">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>

            <Grid ColumnDefinitions="*, Auto">
                <Entry Grid.Column="0" 
               Placeholder="Escribe el Piso/Área (ej: Piso 1, Sótano...)" 
               PlaceholderColor="{AppThemeBinding Light=#A0AEC0, Dark=#718096}"
               Text="{Binding NuevoPisoNombre}" 
               TextColor="{AppThemeBinding Light=#1F2937, Dark=#F7FAFC}"
               FontSize="13" 
               VerticalOptions="Center"/>

                <Button Grid.Column="1" 
                Text="+ Agregar" 
                Command="{Binding AgregarPisoCommand}" 
                BackgroundColor="{AppThemeBinding Light=#2B6CB0, Dark=#3182CE}" 
                TextColor="White" 
                FontAttributes="Bold" 
                FontSize="12" 
                CornerRadius="6" 
                HeightRequest="36" 
                Margin="4,0,0,0"/>
            </Grid>
        </Border>

        <!-- Lista de Pisos Agregados -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Pisos}" Margin="12,0">
            <!-- Estado Vacío -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Margin="0,40">
                    <Label Text="🏢" FontSize="36" HorizontalOptions="Center"/>
                    <Label Text="No has agregado ningún piso o área." 
                   FontAttributes="Bold" 
                   FontSize="13" 
                   TextColor="{AppThemeBinding Light=#718096, Dark=#CBD5E0}"/>
                    <Label Text="Escribe el nombre arriba y presiona '+ Agregar'." 
                   FontSize="11" 
                   TextColor="{AppThemeBinding Light=#A0AEC0, Dark=#718096}"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

           

            <!-- Plantilla de Elemento -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PisoModel">
                    <Border Margin="0,4" 
                    Padding="12" 
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" 
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>

                        <Border.Behaviors> <toolkit:TouchBehavior 
                            PressedBackgroundColor="{AppThemeBinding Light=#EBF8FF, Dark=#2C3E50}" 
                            PressedOpacity="1" />
                        </Border.Behaviors>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.SeleccionarPisoCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                          CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*, Auto, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Nombre}" 
                               FontAttributes="Bold" 
                               FontSize="14" 
                               TextColor="{AppThemeBinding Light=#2D3748, Dark=#F7FAFC}"/>

                                <Label Text="{Binding SeccionesCompletadas, StringFormat='Secciones listas: {0}'}" 
                               FontSize="11" 
                               TextColor="{AppThemeBinding Light=#718096, Dark=#A0AEC0}"/>
                            </VerticalStackLayout>

                            <Label Grid.Column="1" 
                           Text="➔" 
                           FontSize="16" 
                           TextColor="{AppThemeBinding Light=#A0AEC0, Dark=#718096}" 
                           VerticalOptions="Center" 
                           Margin="10,0"/>
                            <Button Grid.Column="2" 
                            Text="🗑" 
                            BackgroundColor="#FEE2E2" 
                            TextColor="{AppThemeBinding Light=#E53E3E, Dark=#FC8181}" 
                            FontSize="15" 
                            HeightRequest="36" 
                            WidthRequest="36" 
                            CornerRadius="6"
                            Padding="0"
                            Command="{Binding BindingContext.EliminarPisoCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                            CommandParameter="{Binding .}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Continuar -->
        <Border Grid.Row="3" 
        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" 
        Padding="10" 
        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}">

            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=Black, Dark=Transparent}" Offset="0,-2" Radius="4" Opacity="0.05" />
            </Border.Shadow>

            <Button Text="Continuar a Resumen / Cierre" 
            Command="{Binding ContinuarCierreCommand}" 
            BackgroundColor="{AppThemeBinding Light=#38A169, Dark=#48BB78}" 
            TextColor="White" 
            FontAttributes="Bold" 
            CornerRadius="8" 
            HeightRequest="44"/>
        </Border>
    </Grid>
</ContentPage>