<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BatiaSuite.Views.SupervisionMantenimiento.Operarios.SupervisionesMantenimientoProgramadasPage"
             xmlns:converters="clr-namespace:BatiaSuite.Converters"
             xmlns:controls="clr-namespace:BatiaSuite.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:const="clr-namespace:BatiaSuite.Utils"
             x:Name="PageRoot"
             Title="Supervisiones"
            BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#121212}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Instancia única del conversor para optimizar memoria -->
            <converters:NullOrEmptyToDefaultConverter x:Key="NullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem
     Text="{Binding SelectedMonth}"
     Command="{Binding GetMonthCommand}" />

        <ToolbarItem
     Text="{Binding FilterYear}"
     Command="{Binding GetYearCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="auto,*">

        <Border Stroke="{AppThemeBinding Light=#B0D4FF, Dark=#2B4C7E}"
        StrokeThickness="1.5"
        BackgroundColor="{AppThemeBinding Light=#F4F8FC, Dark=#1A2836}"
        StrokeShape="RoundRectangle 12"
        Padding="16, 10"
        HorizontalOptions="Fill">

            <VerticalStackLayout Spacing="2">

                <Label FontSize="11"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light=#4A7BB0, Dark=#63B3ED}"
               Text="SUCURSAL"
               CharacterSpacing="0.5" />

                <Entry Placeholder="Ingresa la sucursal"
               PlaceholderColor="{AppThemeBinding Light=#A0B4CC, Dark=#64748B}"
               TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}"
               FontSize="15"
               BackgroundColor="Transparent"
               HeightRequest="40"
               ClearButtonVisibility="WhileEditing"
               Text="{Binding FiltroTexto}" />
            </VerticalStackLayout>
        </Border>

        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding CargarOrdenesCommand}" Grid.Row="1">
            <Grid RowDefinitions="*">

                <!-- Indicador de Carga -->
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                       IsVisible="{Binding IsLoading}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Color="{AppThemeBinding Light=#007ACC, Dark=#38BDF8}"
                       ZIndex="2" />

                <!-- Lista de Órdenes -->
                <CollectionView ItemsSource="{Binding Ordenes}"
                    Margin="12,8"
                    VerticalOptions="Fill"
                    HorizontalOptions="Fill">

                    <!-- Vista cuando no hay órdenes -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="20">
                            <Label Text="📋" FontSize="40" HorizontalOptions="Center" />
                            <Label Text="No hay órdenes de trabajo asignadas"
                       TextColor="{AppThemeBinding Light=#718096, Dark=#A0AEC0}" 
                       FontSize="16" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,5"
                        Padding="14"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                        StrokeThickness="1">

                                <Border.Behaviors>
                                    <toolkit:TouchBehavior Command="{Binding BindingContext.VerFormularioSupervisionCommand, Source={x:Reference PageRoot}}"
                                               CommandParameter="{Binding .}"
                                               PressedBackgroundColor="{AppThemeBinding Light=#EBF8FF, Dark=#2C3E50}"
                                               PressedOpacity="1" />
                                </Border.Behaviors>

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="8">

                                    <!-- CABECERA -->
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label Text="{Binding cliente, StringFormat='CLIENTE: {0}'}"
                                       FontSize="11" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#586069, Dark=#A0AEC0}" />

                                            <Label Text="{Binding cliente}"
                                       FontSize="15" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#24292E, Dark=#F7FAFC}"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2" />
                                        </VerticalStackLayout>

                                        <!-- Píldora ID de Orden -->
                                        <Border Grid.Column="1"
                                    BackgroundColor="{AppThemeBinding Light=#F1F8FF, Dark=#1E2D42}"
                                    Stroke="{AppThemeBinding Light=#C8E1FF, Dark=#2B4C7E}"
                                    StrokeThickness="1"
                                    Padding="8,4"
                                    VerticalOptions="Start"
                                    HorizontalOptions="End">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding idOrden, StringFormat='#{0}'}"
                                       FontAttributes="Bold" 
                                       FontSize="13" 
                                       TextColor="{AppThemeBinding Light=#0366D6, Dark=#63B3ED}" />
                                        </Border>
                                    </Grid>

                                    <!-- SUCURSAL -->
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="6">
                                        <Label Grid.Column="0" Text="📍" FontSize="13" VerticalOptions="Start" />
                                        <Label Grid.Column="1" 
                                   Text="{Binding sucursal}" 
                                   FontSize="13" 
                                   TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}"
                                   LineBreakMode="WordWrap" />
                                    </Grid>

                                    <!-- Línea Divisoria Sutil -->
                                    <BoxView HeightRequest="1" 
                                 BackgroundColor="{AppThemeBinding Light=#EDF2F7, Dark=#2D3748}" 
                                 Margin="0,2" />

                                    <!-- DESCRIPCIÓN -->
                                    <Label Text="{Binding descripcion}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#718096, Dark=#A0AEC0}"
                               LineBreakMode="WordWrap"
                               MaxLines="3" />

                                    <!-- PIE DE TARJETA -->
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="6" Margin="0,4,0,0">

                                        <!-- Badge de Tipo de Mantenimiento -->
                                        <Border Grid.Column="0"
                                    BackgroundColor="{AppThemeBinding Light=#EBF8FF, Dark=#1E2D42}"
                                    Stroke="{AppThemeBinding Light=#BEE3F8, Dark=#2B4C7E}"
                                    StrokeThickness="1"
                                    Padding="8,3"
                                    VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding tipomanto}"
                                       FontSize="11" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2B6CB0, Dark=#63B3ED}" />
                                        </Border>

                                        <!-- Fecha de alta -->
                                        <Grid Grid.Column="2" ColumnDefinitions="Auto, Auto" ColumnSpacing="4" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="📅" FontSize="11" VerticalOptions="Center" />
                                            <Label Grid.Column="1" 
                                       Text="{Binding falta}" 
                                       FontSize="12" 
                                       TextColor="{AppThemeBinding Light=#718096, Dark=#A0AEC0}" 
                                       VerticalOptions="Center" />
                                        </Grid>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </RefreshView>
    </Grid>
</ContentPage>