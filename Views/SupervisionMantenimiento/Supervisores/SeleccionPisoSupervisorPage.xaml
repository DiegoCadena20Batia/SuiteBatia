<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BatiaSuite.Views.SupervisionMantenimiento.Supervisores.SeleccionPisoSupervisorPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:models="clr-namespace:BatiaSuite.Models.SupervisionMantenimiento.Operarios"
             Title="Selección de Pisos / Áreas"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#121212}"
             Shell.NavBarIsVisible="True">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding VolverPantallaDatosCommand}"
                            IsEnabled="True"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- Formulario para Agregar Piso -->
        <Border Grid.Row="1" 
        Margin="12,20,12,10" 
        Padding="6,2" 
        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" 
        Stroke="{AppThemeBinding Light=#CBD5E0, Dark=#2D3748}">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>

            <Grid ColumnDefinitions="*, Auto">
                <Entry Grid.Column="0" 
               Placeholder="Escribe el Piso/Área (ej: Piso 1, Sótano...)" 
               PlaceholderColor="{AppThemeBinding Light=#A0AEC0, Dark=#718096}"
               Text="{Binding NuevoPisoNombre}" 
               TextColor="{AppThemeBinding Light=#1F2937, Dark=#F7FAFC}"
               FontSize="13" 
               VerticalOptions="Center"/>

                <Button Grid.Column="1" 
                Text="+ Agregar" 
                Command="{Binding AgregarPisoCommand}" 
                BackgroundColor="{AppThemeBinding Light=#2B6CB0, Dark=#3182CE}" 
                TextColor="White" 
                FontAttributes="Bold" 
                FontSize="12" 
                CornerRadius="6" 
                HeightRequest="36" 
                Margin="4,0,0,0"/>
            </Grid>
        </Border>

        <!-- Lista de Pisos Agregados -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Pisos}" Margin="12,0">
            <!-- Estado Vacío -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Margin="0,40">
                    <Label Text="🏢" FontSize="36" HorizontalOptions="Center"/>
                    <Label Text="No has agregado ningún piso o área." 
                   FontAttributes="Bold" 
                   FontSize="13" 
                   TextColor="{AppThemeBinding Light=#718096, Dark=#CBD5E0}"/>
                    <Label Text="Escribe el nombre arriba y presiona '+ Agregar'." 
                   FontSize="11" 
                   TextColor="{AppThemeBinding Light=#A0AEC0, Dark=#718096}"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!-- Plantilla de Elemento -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:PisoModel">
                    <Border Margin="0,4" 
                    Padding="12" 
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" 
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="*, Auto, Auto" VerticalOptions="Center">

                            <!-- Gesto de navegación limitado a columnas 0 y 1, NO incluye el botón -->
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.SeleccionarPisoCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                               CommandParameter="{Binding .}"/>
                            </Grid.GestureRecognizers>

                            <VerticalStackLayout Grid.Column="0" Spacing="2" InputTransparent="True">
                                <Label Text="{Binding Nombre}" 
                               FontAttributes="Bold" 
                               FontSize="14" 
                               TextColor="{AppThemeBinding Light=#2D3748, Dark=#F7FAFC}"/>

                                <Label Text="{Binding SeccionesCompletadas, StringFormat='Secciones listas: {0}'}" 
                               FontSize="11" 
                               TextColor="{AppThemeBinding Light=#718096, Dark=#A0AEC0}"/>
                            </VerticalStackLayout>

                            <Label Grid.Column="1" 
                           Text="➔" 
                           FontSize="16" 
                           TextColor="{AppThemeBinding Light=#A0AEC0, Dark=#718096}" 
                           VerticalOptions="Center" 
                           Margin="10,0"
                           InputTransparent="True"/>

                            <Button Grid.Column="2" 
                            Text="🗑" 
                            BackgroundColor="#FEE2E2" 
                            TextColor="{AppThemeBinding Light=#E53E3E, Dark=#FC8181}" 
                            FontSize="15" 
                            HeightRequest="36" 
                            WidthRequest="36" 
                            CornerRadius="6"
                            Padding="0"
                            Command="{Binding BindingContext.EliminarPisoCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                            CommandParameter="{Binding .}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


        <!-- Continuar -->
        <Border Grid.Row="3" 
        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" 
        Padding="10" 
        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}">

            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=Black, Dark=Transparent}" Offset="0,-2" Radius="4" Opacity="0.05" />
            </Border.Shadow>

            <Button Text="Continuar a Resumen / Cierre" 
            Command="{Binding ContinuarCierreCommand}" 
            BackgroundColor="{AppThemeBinding Light=#38A169, Dark=#48BB78}" 
            TextColor="White" 
            FontAttributes="Bold" 
            CornerRadius="8" 
            HeightRequest="44"/>
        </Border>
    </Grid>
</ContentPage>