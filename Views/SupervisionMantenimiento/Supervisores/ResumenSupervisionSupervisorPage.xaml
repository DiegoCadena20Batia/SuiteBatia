<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BatiaSuite.Views.SupervisionMantenimiento.Supervisores.ResumenSupervisionSupervisorPage"
             xmlns:local="clr-namespace:BatiaSuite.Models.SupervisionMantenimiento.Supervisores"
             xmlns:views="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="Cierre de Supervisión"
             xmlns:flags="clr-namespace:BatiaSuite.Utils"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#121212}">
    <Grid>

        <!-- RESUMEN GENERAL DE LA SUPERVISIÓN -->
        <ScrollView Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- 1. INSTRUCCIONES DE CALIFICACIÓN -->
                <Label Margin="0,4,0,4"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               FontSize="12"
               TextColor="{AppThemeBinding Light=#718096, Dark=#A0AEC0}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Califique cada aspecto del " />
                            <Span Text="1 al 5" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2B6CB0, Dark=#63B3ED}" />
                            <Span Text=", donde:" />
                            <Span Text="1 = Muy malo  |  2 = Malo  |  3 = Regular  |  4 = Bueno  |  5 = Excelente" FontAttributes="Italic" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- 2. PREGUNTAS / CALIFICACIÓN DEL CLIENTE -->
                <CollectionView ItemsSource="{Binding Preguntas}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:PreguntaResumenModel">
                            <Border Margin="0,6"
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                            StrokeThickness="1.5">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding EstaRespondida}" Value="True">
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light=#38A169, Dark=#48BB78}" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F6FFF8, Dark=#1A2E22}" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <VerticalStackLayout Spacing="10">
                                    <!-- Pregunta y Estatus -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0"
                                       Text="{Binding descripcion}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#1F2937, Dark=#F7FAFC}" />

                                        <Label Grid.Column="1"
                                       Text="✓"
                                       TextColor="{AppThemeBinding Light=#38A169, Dark=#48BB78}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       IsVisible="{Binding EstaRespondida}"
                                       VerticalOptions="Start" />
                                    </Grid>

                                    <!-- BOTONES DE SELECCIÓN (1 a 5) -->
                                    <Grid ColumnDefinitions="*, *, *, *, *" ColumnSpacing="4" Margin="0,4,0,0">

                                        <!-- 1 = Muy Malo -->
                                        <Button Grid.Column="0" Text="1" FontSize="8" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Padding="0"
                                        BackgroundColor="{AppThemeBinding Light=#EDF2F7, Dark=#2D3748}" TextColor="{AppThemeBinding Light=#2D3748, Dark=#E2E8F0}"
                                        Command="{Binding SeleccionarRespuestaCommand}" CommandParameter="1">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding Respuesta}" Value="1">
                                                    <Setter Property="BackgroundColor" Value="#E53E3E" />
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>

                                        <!-- 2 = Malo -->
                                        <Button Grid.Column="1" Text="2" FontSize="8" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Padding="0"
                                        BackgroundColor="{AppThemeBinding Light=#EDF2F7, Dark=#2D3748}" TextColor="{AppThemeBinding Light=#2D3748, Dark=#E2E8F0}"
                                        Command="{Binding SeleccionarRespuestaCommand}" CommandParameter="2">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding Respuesta}" Value="2">
                                                    <Setter Property="BackgroundColor" Value="#DD6B20" />
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>

                                        <!-- 3 = Regular -->
                                        <Button Grid.Column="2" Text="3" FontSize="8" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Padding="0"
                                        BackgroundColor="{AppThemeBinding Light=#EDF2F7, Dark=#2D3748}" TextColor="{AppThemeBinding Light=#2D3748, Dark=#E2E8F0}"
                                        Command="{Binding SeleccionarRespuestaCommand}" CommandParameter="3">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding Respuesta}" Value="3">
                                                    <Setter Property="BackgroundColor" Value="#D69E2E" />
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>

                                        <!-- 4 = Bueno -->
                                        <Button Grid.Column="3" Text="4" FontSize="8" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Padding="0"
                                        BackgroundColor="{AppThemeBinding Light=#EDF2F7, Dark=#2D3748}" TextColor="{AppThemeBinding Light=#2D3748, Dark=#E2E8F0}"
                                        Command="{Binding SeleccionarRespuestaCommand}" CommandParameter="4">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding Respuesta}" Value="4">
                                                    <Setter Property="BackgroundColor" Value="#3182CE" />
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>

                                        <!-- 5 = Excelente -->
                                        <Button Grid.Column="4" Text="5" FontSize="8" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Padding="0"
                                        BackgroundColor="{AppThemeBinding Light=#EDF2F7, Dark=#2D3748}" TextColor="{AppThemeBinding Light=#2D3748, Dark=#E2E8F0}"
                                        Command="{Binding SeleccionarRespuestaCommand}" CommandParameter="5">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding Respuesta}" Value="5">
                                                    <Setter Property="BackgroundColor" Value="#38A169" />
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>

                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- 3. OBSERVACIONES GENERALES -->
                <Border Padding="14"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                StrokeThickness="1.5">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Observaciones Generales"
                       FontAttributes="Bold"
                       FontSize="15"
                       TextColor="{AppThemeBinding Light=#2B6CB0, Dark=#63B3ED}" />

                        <Editor Placeholder="Ingresa comentarios, hallazgos o notas adicionales..."
                        PlaceholderColor="{AppThemeBinding Light=#A0AEC0, Dark=#718096}"
                        Text="{Binding ObservacionesGenerales}"
                        TextColor="{AppThemeBinding Light=#1A202C, Dark=#F7FAFC}"
                        HeightRequest="100"
                        AutoSize="Disabled"
                        FontSize="13"
                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#2A323D}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 4. FIRMA DEL SUPERVISOR -->
                <Border Padding="14"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                StrokeThickness="1.5">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Supervisor"
                       FontAttributes="Bold"
                       FontSize="15"
                       TextColor="{AppThemeBinding Light=#2B6CB0, Dark=#63B3ED}" />

                        <Label Text="Firma del Supervisor:"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" />

                        <Border Stroke="{AppThemeBinding Light=#CBD5E0, Dark=#4A5568}"
                        StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <views:DrawingView x:Name="tecnicoDrawingView"
                                       LineColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}"
                                       LineWidth="3"
                                       Lines="{Binding LineasTecnico}"
                                       HeightRequest="120"
                                       IsMultiLineModeEnabled="True"
                                       ShouldClearOnFinish="False"
                                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A323D}" />
                        </Border>

                        <Button Text="Limpiar Firma"
                        Clicked="OnLimpiarFirmaTecnicoClicked"
                        FontSize="11"
                        HeightRequest="32"
                        HorizontalOptions="End"
                        BackgroundColor="{AppThemeBinding Light=#EDF2F7, Dark=#2D3748}"
                        TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 5. FIRMA Y CONFORMIDAD DEL CLIENTE -->
                <Border Padding="14"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
                StrokeThickness="1.5">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Conformidad del Cliente"
                       FontAttributes="Bold"
                       FontSize="15"
                       TextColor="{AppThemeBinding Light=#2B6CB0, Dark=#63B3ED}" />

                        <Label Text="Firma del Cliente:"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" />

                        <Border Stroke="{AppThemeBinding Light=#CBD5E0, Dark=#4A5568}"
                        StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <views:DrawingView x:Name="clienteDrawingView"
                                       LineColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}"
                                       LineWidth="3"
                                       Lines="{Binding LineasCliente}"
                                       HeightRequest="120"
                                       IsMultiLineModeEnabled="True"
                                       ShouldClearOnFinish="False"
                                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A323D}" />
                        </Border>

                        <Button Text="Limpiar Firma"
                        Clicked="OnLimpiarFirmaClienteClicked"
                        FontSize="11"
                        HeightRequest="32"
                        HorizontalOptions="End"
                        BackgroundColor="{AppThemeBinding Light=#EDF2F7, Dark=#2D3748}"
                        TextColor="{AppThemeBinding Light=#4A5568, Dark=#CBD5E0}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 6. ACCIÓN PRINCIPAL -->
                <Button Text="ENVIAR SUPERVISIÓN"
                Command="{Binding GuardarSupervisionCommand}"
                FontAttributes="Bold"
                FontSize="14"
                HeightRequest="48"
                CornerRadius="10"
                BackgroundColor="#38A169"
                TextColor="White"
                Margin="0,10,0,20" />

            </VerticalStackLayout>
        </ScrollView>
        <!-- CAPA DE CARGA -->
        <Grid BackgroundColor="{AppThemeBinding Light=#80000000, Dark=#B0000000}"
        IsVisible="{Binding IsBusy}"
        InputTransparent="False">

            <Border Padding="24,20"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
              Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}"
              StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                 Color="{AppThemeBinding Light=#2B6CB0, Dark=#63B3ED}"
                                 HeightRequest="40"
                                 WidthRequest="40" />

                    <Label Text="Guardando supervisión..."
                     FontSize="13"
                     FontAttributes="Bold"
                     TextColor="{AppThemeBinding Light=#2D3748, Dark=#E2E8F0}"
                     HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Botón auxiliar de testing rápido -->
        <!--<Button Text="⚡ AUTO-LLENAR (DEBUG)"
        Command="{Binding AutoLlenarSupervisionModoDebugCommand}"
        IsVisible="{x:Static flags:DebugFlags.EsDebug}"
        BackgroundColor="#E53E3E"
        TextColor="White"
        FontAttributes="Bold"
        CornerRadius="8"
        HeightRequest="36"
        Margin="0,0,0,10"/>-->
    </Grid>
</ContentPage>