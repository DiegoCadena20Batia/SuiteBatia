<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BatiaSuite.Views.SupervisionMantenimiento.Supervisores.SupervisionMantenimientoSupervisorPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="Supervisión Mantenimiento"
             xmlns:utils="clr-namespace:BatiaSuite.Utils"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             BackgroundColor="WhiteSmoke">
    <ScrollView BackgroundColor="#F1F5F9" Padding="16,12">
        <VerticalStackLayout Spacing="16">

           
            <Border StrokeShape="RoundRectangle 20"
                BackgroundColor="#0F172A"
                Stroke="Transparent"
                Padding="16,14">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Offset="0,6" Radius="12" Opacity="0.15" />
                </Border.Shadow>

                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">

                    <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 24"
                        HeightRequest="48" 
                        WidthRequest="48"
                        Stroke="#38BDF8" 
                        StrokeThickness="2"
                        BackgroundColor="#1E293B"
                        Margin="0,0,12,0"
                        Padding="0">
                        <Image Source="profile.png" Aspect="AspectFill" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="SUPERVISOR ACTIVO" 
                           FontSize="10" 
                           TextColor="#38BDF8" 
                           FontAttributes="Bold" 
                           CharacterSpacing="1" />
                        <Label Text="{x:Static utils:UserSession.NOMBRE}" 
                           FontSize="16" 
                           TextColor="White" 
                           FontAttributes="Bold" 
                           LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <Border Grid.Column="2"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#1E293B"
                        Stroke="#334155"
                        Padding="10,6">
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                           
                            <Label Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{0:dd MMM}'}" 
                               TextColor="#F8FAFC" 
                               FontSize="13" 
                               HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <Border StrokeShape="RoundRectangle 20"
                BackgroundColor="White"
                Stroke="Transparent"
                Padding="20">
                <Border.Shadow>
                    <Shadow Brush="#64748B" Offset="0,4" Radius="10" Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">

                    <Label Text="Datos del Servicio" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="#0F172A" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Tipo de Servicio" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />
                        <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            Padding="10,2">
                            <Picker Title="-- Seleccione tipo --"
                                ItemsSource="{Binding TiposServicio}"
                                SelectedItem="{Binding TipoServicioSelected}"
                                    ItemDisplayBinding="{Binding Descripcion}"
                                TitleColor="#94A3B8"
                                TextColor="#0F172A"
                                FontSize="14"
                                HeightRequest="44" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Cliente" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />
                        <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            Padding="10,2">
                            <Picker 
                                Title="-- Seleccione cliente --" 
                                ItemsSource="{Binding Clientes}" 
                                SelectedItem="{Binding ClienteSelected, Mode=TwoWay}" 
                                ItemDisplayBinding="{Binding nombre}" 
                                TitleColor="#94A3B8" 
                                TextColor="#0F172A" 
                                FontSize="14" 
                                HeightRequest="44">
                                <Picker.Behaviors>
                                    <toolkit:EventToCommandBehavior 
                                        EventName="SelectedIndexChanged" 
                                        Command="{Binding ObtenerSucursalesCommand}" />
                                </Picker.Behaviors>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Sucursal" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />
                        <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            Padding="10,2">
                            <Picker Title="-- Seleccione sucursal --"
                                ItemsSource="{Binding Inmuebles}"
                                SelectedItem="{Binding InmuebleSelected, Mode=TwoWay}"
                                ItemDisplayBinding="{Binding nombre}"
                                IsEnabled="{Binding SucursalesHabilitadas}"
                                TitleColor="#94A3B8"
                                TextColor="#0F172A"
                                FontSize="14"
                                HeightRequest="44" />
                        </Border>
                    </VerticalStackLayout>

                 

                </VerticalStackLayout>
            </Border>


            <Button Text="Continuar a Secciones ➔"
        Command="{Binding IrASeccionesCommand}"
        BackgroundColor="#2563EB"
        TextColor="White"
        FontSize="16"
        FontAttributes="Bold"
        HeightRequest="54"
        CornerRadius="14"
        Margin="0,8,0,0">
                <Button.Shadow>
                    <Shadow Brush="#2563EB" Offset="0,6" Radius="12" Opacity="0.3" />
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>