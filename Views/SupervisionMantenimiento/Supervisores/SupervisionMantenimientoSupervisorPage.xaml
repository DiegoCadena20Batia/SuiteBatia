<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BatiaSuite.Views.SupervisionMantenimiento.Supervisores.SupervisionMantenimientoSupervisorPage"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="Supervisión Mantenimiento"
             xmlns:utils="clr-namespace:BatiaSuite.Utils"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Style="{StaticResource PageStyle}">
    
    
    <ScrollView BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0F172A}" Padding="16,12">
        <VerticalStackLayout Spacing="16">

            <!-- Header Supervisor -->
            <Border StrokeShape="RoundRectangle 20"
                BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=#1E293B}"
                Stroke="Transparent"
                Padding="16,14">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Offset="0,6" Radius="12" Opacity="{AppThemeBinding Light=0.15, Dark=0.3}" />
                </Border.Shadow>

                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">

                    <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 24"
                        HeightRequest="48" 
                        WidthRequest="48"
                        Stroke="#38BDF8" 
                        StrokeThickness="2"
                        BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#0F172A}"
                        Margin="0,0,12,0"
                        Padding="0">
                        <Image Source="profile.png" Aspect="AspectFill" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="SUPERVISOR ACTIVO" 
                           FontSize="10" 
                           TextColor="#38BDF8" 
                           FontAttributes="Bold" 
                           CharacterSpacing="1" />
                        <Label Text="{x:Static utils:UserSession.NOMBRE}" 
                           FontSize="16" 
                           TextColor="White" 
                           FontAttributes="Bold" 
                           LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <Border Grid.Column="2"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#1E293B, Dark=#0F172A}"
                        Stroke="{AppThemeBinding Light=#334155, Dark=#334155}"
                        Padding="10,6">
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                            <Label Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{0:dd MMM}'}" 
                               TextColor="#F8FAFC" 
                               FontSize="13" 
                               HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <!-- Card Formulario "Datos del Servicio" -->
            <Border StrokeShape="RoundRectangle 20"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                Stroke="{AppThemeBinding Light=Transparent, Dark=#334155}"
                StrokeThickness="{AppThemeBinding Light=0, Dark=1}"
                Padding="20">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="{AppThemeBinding Light=0.08, Dark=0.25}" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">

                    <Label Text="Datos del Servicio" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                    <!-- Tipo de Servicio -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Tipo de Servicio" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                            Padding="10,2">
                            <Picker Title="-- Seleccione tipo --"
                                ItemsSource="{Binding TiposServicio}"
                                SelectedItem="{Binding TipoServicioSelected}"
                                ItemDisplayBinding="{Binding Descripcion}"
                                TitleColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                FontSize="14"
                                HeightRequest="44" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Cliente -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Cliente" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                            Padding="10,2">
                            <Picker Title="-- Seleccione cliente --" 
                                ItemsSource="{Binding Clientes}" 
                                SelectedItem="{Binding ClienteSelected, Mode=TwoWay}" 
                                ItemDisplayBinding="{Binding nombre}" 
                                TitleColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" 
                                TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" 
                                FontSize="14" 
                                HeightRequest="44">
                                <Picker.Behaviors>
                                    <toolkit:EventToCommandBehavior 
                                    EventName="SelectedIndexChanged" 
                                    Command="{Binding ObtenerSucursalesCommand}" />
                                </Picker.Behaviors>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Sucursal -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Sucursal" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                        <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                            Padding="10,2">
                            <Picker Title="-- Seleccione sucursal --"
                                ItemsSource="{Binding Inmuebles}"
                                SelectedItem="{Binding InmuebleSelected, Mode=TwoWay}"
                                ItemDisplayBinding="{Binding nombre}"
                                IsEnabled="{Binding SucursalesHabilitadas}"
                                TitleColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                FontSize="14"
                                HeightRequest="44" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Botón Principal -->
            <Button Text="Continuar a Secciones ➔"
                Command="{Binding IrASeccionesCommand}"
                BackgroundColor="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                HeightRequest="54"
                CornerRadius="14"
                Margin="0,8,0,0">
                <Button.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}" Offset="0,6" Radius="12" Opacity="0.3" />
                </Button.Shadow>
            </Button>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>