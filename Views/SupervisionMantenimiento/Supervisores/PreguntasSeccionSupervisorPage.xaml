<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BatiaSuite.Views.SupervisionMantenimiento.Supervisores.PreguntasSeccionSupervisorPage"
             xmlns:vm="clr-namespace:BatiaSuite.ViewModel.SupervisionMantenimiento.Supervisores"
             xmlns:models="clr-namespace:BatiaSuite.Models.SupervisionMantenimiento.Operarios"
             x:DataType="vm:PreguntasSeccionSupervisorViewModel"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#121212}"
             Shell.NavBarIsVisible="True"
             Title="{Binding Seccion.Seccion, StringFormat='Sección: {0}'}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding VolverPantallaIteracionesCommand}"
                         IsEnabled="True"/>
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 1. ENCABEZADO DE LA SECCIÓN (FIJO ARRIBA) -->
        <Border Grid.Row="0" 
            Margin="12,10" 
            Padding="14" 
            BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#121212}" 
            Stroke="#E1E4E8" 
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>

            <Grid ColumnDefinitions="Auto, *" >
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" >
                    <!--<Label Grid.Column="0" Text="{Binding Seccion.Seccion, StringFormat='Sección: {0}'}" FontSize="20" VerticalOptions="Center" Margin="0,0,12,0"/>-->
                    <Label Text="{Binding Piso.Nombre, StringFormat='Piso: {0}'}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2937, Dark=#FFFFFF}"/>
                    <Label Text="{Binding Iteracion.Nombre}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2937, Dark=#FFFFFF}" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- 2. CONTENIDO SCROLLEABLE (PREGUNTAS + FOTOS) -->
        <ScrollView Grid.Row="1" Padding="12,0">
            <VerticalStackLayout Spacing="16">

                <!-- LISTA DE PREGUNTAS (Usando BindableLayout para evitar conflictos de scroll) -->
                <StackLayout BindableLayout.ItemsSource="{Binding Iteracion.Preguntas}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:PreguntaModel">
                            <Border Margin="0,6" 
        Padding="14" 
        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" 
        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}" 
        StrokeThickness="1.5">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>

                                <Border.Triggers>
                                    <!-- Marco en verde cuando está respondida -->
                                    <DataTrigger TargetType="Border" Binding="{Binding EstaRespondida}" Value="True">
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light=#38A169, Dark=#48BB78}" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F6FFF8, Dark=#1A2E22}" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <VerticalStackLayout Spacing="10">
                                    <!-- Encabezado de la Pregunta -->
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Label Grid.Column="0" 
                   Text="{Binding IdPregunta, StringFormat='{0}.'}" 
                   FontAttributes="Bold" 
                   FontSize="14" 
                   TextColor="{AppThemeBinding Light=#2B6CB0, Dark=#63B3ED}" 
                   Margin="0,0,6,0"/>

                                        <Label Grid.Column="1" 
                   Text="{Binding Pregunta}" 
                   FontSize="13" 
                   TextColor="{AppThemeBinding Light=#1F2937, Dark=#F7FAFC}" 
                   LineBreakMode="WordWrap"/>

                                        <Label Grid.Column="2" 
                   Text="✓" 
                   TextColor="{AppThemeBinding Light=#38A169, Dark=#48BB78}" 
                   FontAttributes="Bold" 
                   FontSize="16"
                   IsVisible="{Binding EstaRespondida}" 
                   VerticalOptions="Start" 
                   Margin="6,0,0,0"/>
                                    </Grid>

                                    <!-- BOTONES DE RESPUESTA RÁPIDA -->
                                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8" Margin="0,4,0,0">

                                        <!-- Botón BUENO (Valor = 2) -->
                                        <Button Grid.Column="0" 
                    Text="✓ SI" 
                    FontSize="12" 
                    FontAttributes="Bold" 
                    CornerRadius="8" 
                    HeightRequest="38" 
                    BackgroundColor="{AppThemeBinding Light=#EDF2F7, Dark=#2D3748}" 
                    TextColor="{AppThemeBinding Light=#2D3748, Dark=#E2E8F0}"
                    Command="{Binding SeleccionarRespuestaCommand}"
                    CommandParameter="2">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding Respuesta}" Value="2">
                                                    <Setter Property="BackgroundColor" Value="#38A169" />
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>

                                        <!-- Botón MALO (Valor = 1) -->
                                        <Button Grid.Column="1" 
                    Text="✕ NO" 
                    FontSize="12" 
                    FontAttributes="Bold" 
                    CornerRadius="8" 
                    HeightRequest="38" 
                    BackgroundColor="{AppThemeBinding Light=#EDF2F7, Dark=#2D3748}" 
                    TextColor="{AppThemeBinding Light=#2D3748, Dark=#E2E8F0}"
                    Command="{Binding SeleccionarRespuestaCommand}"
                    CommandParameter="1">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding Respuesta}" Value="1">
                                                    <Setter Property="BackgroundColor" Value="#E53E3E" />
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>

                                        <!-- Botón N/A (Valor = 0) -->
                                        <Button Grid.Column="2" 
                    Text="— N/A" 
                    FontSize="12" 
                    FontAttributes="Bold" 
                    CornerRadius="8" 
                    HeightRequest="38"
                    BackgroundColor="{AppThemeBinding Light=#EDF2F7, Dark=#2D3748}" 
                    TextColor="{AppThemeBinding Light=#2D3748, Dark=#E2E8F0}"
                    Command="{Binding SeleccionarRespuestaCommand}" 
                    CommandParameter="0">
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button" Binding="{Binding Respuesta}" Value="0">
                                                    <Setter Property="BackgroundColor" Value="#718096" />
                                                    <Setter Property="TextColor" Value="White" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>
                                    </Grid>

                                    <!-- Observaciones -->
                                    <Entry Placeholder="Observaciones / Comentarios (Opcional)" 
               PlaceholderColor="{AppThemeBinding Light=#A0AEC0, Dark=#718096}"
               Text="{Binding Observaciones}" 
               FontSize="12" 
               BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2A2A2A}" 
               TextColor="{AppThemeBinding Light=#1F2937, Dark=#F7FAFC}" 
               Margin="0,2,0,0"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </StackLayout>

                <!-- SECCIÓN DE FOTOGRAFÍAS DE EVIDENCIA -->
                <Border StrokeShape="RoundRectangle 14"
        StrokeThickness="1"
        Stroke="{AppThemeBinding Light=#E9ECEF, Dark=#27272A}"
        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="{AppThemeBinding Light=0.03, Dark=0.2}" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <!-- Encabezado y Botón Añadir -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Fotografías de Evidencia" 
                       FontFamily="MontBold" 
                       FontSize="16" 
                       TextColor="{AppThemeBinding Light=#1A3B60, Dark=#F8FAFC}" />
                                <Label Text="Máximo 5 imágenes de soporte" 
                       FontFamily="MontRegular" 
                       FontSize="12" 
                       TextColor="{AppThemeBinding Light=#6C757D, Dark=#A1A1AA}" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                    BackgroundColor="{AppThemeBinding Light=#EEF4FA, Dark=#27272A}"
                    TextColor="{AppThemeBinding Light=#4A92FE, Dark=#60A5FA}"
                    ImageSource="camera.png"
                    ContentLayout="Left,8"
                    Text="AÑADIR"
                    FontFamily="MontBold"
                    FontSize="13"
                    HeightRequest="40"
                    Padding="14,0"
                    CornerRadius="8"
                    Command="{Binding PhotoCommand}" />
                        </Grid>

                        <!-- Contenedor del Carrusel e Indicadores -->
                        <Grid RowDefinitions="Auto, Auto" Margin="0,5,0,0">
                            <CarouselView Grid.Row="0" 
                          x:Name="MiCarrusel" 
                          Loop="False" 
                          ItemsSource="{Binding PhotoPaths}" 
                          IndicatorView="MiIndicador" 
                          HeightRequest="350" 
                          PeekAreaInsets="20">

                                <!-- Vista Vacía (Sin Fotos) -->
                                <CarouselView.EmptyView>
                                    <Border StrokeShape="RoundRectangle 10" 
                            StrokeThickness="1" 
                            StrokeDashArray="4,4" 
                            Stroke="{AppThemeBinding Light=#CED4DA, Dark=#3F3F46}" 
                            BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#18181B}" 
                            HeightRequest="330" 
                            WidthRequest="250" 
                            HorizontalOptions="Start" 
                            Margin="5">
                                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                                            <Label Text="📸" FontSize="28" HorizontalOptions="Center"/>
                                            <Label Text="Ninguna foto capturada aún" 
                                   FontFamily="MontSemibold" 
                                   FontSize="13" 
                                   TextColor="{AppThemeBinding Light=#6C757D, Dark=#A1A1AA}" 
                                   HorizontalTextAlignment="Center"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </CarouselView.EmptyView>

                                <!-- Plantilla de Foto Capturada -->
                                <CarouselView.ItemTemplate>
                                    <DataTemplate x:DataType="models:FotoModel">
                                        <Border StrokeShape="RoundRectangle 10" 
                                StrokeThickness="1" 
                                Stroke="{AppThemeBinding Light=#E9ECEF, Dark=#27272A}" 
                                Margin="6,5" 
                                BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#18181B}" 
                                HeightRequest="330">
                                            <Grid RowDefinitions="*" ColumnDefinitions="*">
                                                <Image Grid.Row="0" Grid.Column="0" 
                                       Source="{Binding LocalPath}" 
                                       Aspect="AspectFill" 
                                       HorizontalOptions="Fill" 
                                       VerticalOptions="Fill" />

                                                <Button Text="✕" 
                                        Grid.Row="0" Grid.Column="0" 
                                        TextColor="White" 
                                        BackgroundColor="{AppThemeBinding Light=#CC0000, Dark=#EF4444}" 
                                        FontSize="14" 
                                        FontAttributes="Bold" 
                                        WidthRequest="45" 
                                        HeightRequest="45" 
                                        CornerRadius="30" 
                                        Padding="0" 
                                        HorizontalOptions="End" 
                                        VerticalOptions="Start" 
                                        Margin="6" 
                                        Command="{Binding Source={x:Reference MiIndicador}, Path=BindingContext.DeletePhotoCommand}" 
                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CarouselView.ItemTemplate>
                            </CarouselView>

                            <!-- Puntos de Navegación -->
                            <IndicatorView Grid.Row="1"
                           x:Name="MiIndicador"
                           IndicatorColor="{AppThemeBinding Light=#DDE2E5, Dark=#3F3F46}"
                           SelectedIndicatorColor="{AppThemeBinding Light=#4A92FE, Dark=#60A5FA}"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 3. BOTÓN INFERIOR DE GUARDAR (FIJO ABAJO) -->
        <Border Grid.Row="2" 
        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" 
        Padding="12" 
        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D3748}">

            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=Black, Dark=Transparent}" Offset="0,-2" Radius="4" Opacity="0.05" />
            </Border.Shadow>

            <Button Text="Guardar" 
            Command="{Binding GuardarSeccionCommand}" 
            BackgroundColor="{AppThemeBinding Light=#007ACC, Dark=#0098FF}" 
            TextColor="White" 
            FontAttributes="Bold" 
            CornerRadius="10" 
            HeightRequest="46"/>
        </Border>

    </Grid>
</ContentPage>