<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="BatiaSuite.Views.MenuSuite"
    xmlns:vm="clr-namespace:BatiaSuite.ViewModel"
    xmlns:icons="clr-namespace:BatiaSuite.Resources.IconFonts"
    xmlns:utils="clr-namespace:BatiaSuite.Utils"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:myConverters="clr-namespace:BatiaSuite.Converters"
    Style="{StaticResource PageStyle}"
    BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#121212}"
    Shell.NavBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:TextCaseConverter
                x:Key="TextCaseConverter"
                Type="Upper" />
            <myConverters:DoubleToBoolConverter
                x:Key="DoubleToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.BindingContext>
        <vm:MenuSuiteViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <Grid RowDefinitions="auto, auto, *, auto"
          ColumnDefinitions="*, auto"
          Margin="0, 5, 0, 0">

            <!-- Mensaje de Bienvenida -->
            <Label Text="Bienvenido(a)"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Start"
               FontFamily="MontSemibold"
               FontSize="{OnIdiom 16, Tablet=22}"
               TextColor="{AppThemeBinding Light=#1E293B, Dark=#F8FAFC}"
               Margin="0, 0, 0, 5" />

            <!-- Nombre de Usuario -->
            <Label Grid.Row="1"
               Text="{x:Static utils:UserSession.NOMBRE}"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Start"
               FontFamily="MontSemibold"
               FontSize="{OnIdiom 18, Tablet=24}"
               TextColor="{AppThemeBinding Light=#0F172A, Dark=#FFFFFF}"
               Margin="0, 0, 0, 10" />

            <!-- Botón Logout -->
            <ImageButton Grid.Column="1"
                     Grid.RowSpan="2"
                     VerticalOptions="Center"
                     HeightRequest="30"
                     Scale="{OnPlatform Android=1, iOS=1}"
                     Command="{Binding LogoutCommand}"
                     Margin="0, 0, 15, 0">
                <ImageButton.Source>
                    <FontImageSource Glyph="{x:Static icons:Icons.Logout}"
                                 FontFamily="{x:Static icons:Icons.Family}"
                                 Color="{AppThemeBinding Light={StaticResource AzulClaro}, Dark=#60A5FA}" />
                </ImageButton.Source>
            </ImageButton>

            <!-- Contenido de Módulos (RefreshView + CollectionView) -->
            <RefreshView Grid.Row="2"
                     Grid.ColumnSpan="2"
                     x:Name="RefreshViewModulos"
                     VerticalOptions="Fill"
                     HorizontalOptions="Fill"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshPageCommand}"
                     RefreshColor="{AppThemeBinding Light={StaticResource AzulClaro}, Dark=#60A5FA}"
                     Margin="0">

                <CollectionView x:Name="collectionView"
                            ItemsSource="{Binding Monkeys}"
                            VerticalOptions="Fill"
                            HorizontalOptions="Fill"
                            VerticalScrollBarVisibility="Never">
                    <CollectionView.Footer>
                        <BoxView HeightRequest="90" Color="Transparent" />
                    </CollectionView.Footer>

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                    </CollectionView.ItemsLayout>

                    <!-- Vista Vacía -->
                    <CollectionView.EmptyView>
                        <Label Margin="20, 100"
                           FontSize="{OnIdiom 18, Tablet=25}"
                           VerticalOptions="Start"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#A1A1AA}"
                           Text="Sin módulos asignados, verifique con su encargado" />
                    </CollectionView.EmptyView>

                    <!-- Items del Módulo -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="5,2,5,2"
                               Style="{StaticResource FrameStyle}"
                               BorderColor="{AppThemeBinding Light=LightBlue, Dark=#27272A}"
                               BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                               Padding="0"
                               CornerRadius="20">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=BindingContext.NextPageCommand, Source={x:Reference collectionView}}"
                                                      CommandParameter="{Binding Name}"
                                                      Tapped="TapGestureRecognizer_Tapped" />
                                </Frame.GestureRecognizers>

                                <Grid ColumnDefinitions="auto, *" RowDefinitions="auto">

                                    <!-- Gráfica de Porcentaje -->
                                    <Grid RowDefinitions="auto, auto"
                                      BindingContext="{Binding OrdenesTotales}"
                                      WidthRequest="{Binding Width}"
                                      HeightRequest="{Binding Height}"
                                      VerticalOptions="Center">

                                        <BoxView Color="Green"
                                             HeightRequest="{Binding HeightSupRealizadas}" />

                                        <Label Text="{Binding PorcentajeSupRealizadas, StringFormat='{0:f0} %'}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           FontSize="11"
                                           TextColor="White"
                                           IsVisible="{Binding PorcentajeSupRealizadas, Converter={StaticResource DoubleToBoolConverter}}" />

                                        <BoxView Grid.Row="1"
                                             Color="Red"
                                             HeightRequest="{Binding HeightSupNoRealizadas}" />

                                        <Label Grid.Row="1"
                                           Text="{Binding PorcentajeSupNoRealizadas, StringFormat='{0:f0} %'}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           FontSize="11"
                                           TextColor="White"
                                           IsVisible="{Binding PorcentajeSupNoRealizadas, Converter={StaticResource DoubleToBoolConverter}}" />
                                    </Grid>

                                    <!-- Información del Módulo -->
                                    <Grid Grid.Column="1"
                                      ColumnDefinitions="auto, *, auto"
                                      RowDefinitions="auto, auto"
                                      ColumnSpacing="{OnIdiom 10, Tablet=20}"
                                      Padding="10"
                                      VerticalOptions="CenterAndExpand">

                                        <Image Grid.RowSpan="2"
                                           Source="{Binding ImageUrl}"
                                           Aspect="AspectFit"
                                           HeightRequest="{OnIdiom 50, Tablet=100}"
                                           WidthRequest="{OnIdiom 50, Tablet=100}" />

                                        <Label Grid.Column="1"
                                           Text="{Binding Name, Converter={StaticResource TextCaseConverter}}"
                                           FontSize="{OnIdiom 15, Tablet=20}"
                                           TextColor="{AppThemeBinding Light=#3775B5, Dark=#60A5FA}"
                                           VerticalTextAlignment="Center"
                                           FontFamily="MontBold" />

                                        <Label Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding Details}"
                                           FontSize="{OnIdiom 11, Tablet=16}"
                                           VerticalTextAlignment="Start"
                                           TextColor="{AppThemeBinding Light=Gray, Dark=#9CA3AF}"
                                           FontFamily="MontRegular" />

                                        <Label Grid.Column="2"
                                           Grid.RowSpan="2"
                                           Style="{StaticResource ContentLabelStyle}"
                                           Text="{x:Static icons:Icons.RightOpen}"
                                           FontFamily="{x:Static icons:Icons.Family}"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark=#6B7280}"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End"
                                           FontSize="{OnIdiom 40, Tablet=60}"
                                           Margin="0, 10" />
                                    </Grid>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Fila 3: Barra inferior de versión -->
            <Grid BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#18181B}"
              Grid.Row="3"
              Grid.ColumnSpan="2"
              Padding="5, 5">

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Label Text="{OnPlatform Android={x:Static icons:Icons.Android}, iOS={x:Static icons:Icons.Apple}}"
                       FontFamily="{x:Static icons:Icons.Family}"
                       TextColor="{AppThemeBinding Light={StaticResource AzulClaro}, Dark=#60A5FA}"
                       VerticalTextAlignment="Center"
                       FontSize="{OnPlatform Android=18, iOS=20}" />

                    <Label Text="{Binding AppName}"
                       TextColor="{AppThemeBinding Light={StaticResource AzulClaro}, Dark=#60A5FA}"
                       VerticalTextAlignment="End"
                       FontAttributes="Bold"
                       FontSize="{OnPlatform Android=18, iOS=20}" />
                </HorizontalStackLayout>

                <HorizontalStackLayout HorizontalOptions="End" Spacing="5">
                    <Label Text="v"
                       TextColor="{AppThemeBinding Light={StaticResource AzulClaro}, Dark=#60A5FA}"
                       FontAttributes="Italic"
                       VerticalTextAlignment="End"
                       FontSize="15" />

                    <Label Text="{Binding AppVersionString}"
                       TextColor="{AppThemeBinding Light={StaticResource AzulClaro}, Dark=#60A5FA}"
                       VerticalTextAlignment="End"
                       FontSize="15"
                       Margin="0, 0, 30, 0" />
                </HorizontalStackLayout>
            </Grid>
        </Grid>

        <!-- 🔔 Campanita Flotante -->
        <Grid IsVisible="{Binding EsSupervisor}"
          HorizontalOptions="Start" 
          VerticalOptions="End"
          WidthRequest="35" 
          HeightRequest="35" 
          Margin="30, 0, 0, 50">

            <ImageButton VerticalOptions="Center"
                     HorizontalOptions="Center"
                     HeightRequest="25"
                     WidthRequest="25"
                     Source="bell.png"
                     Command="{Binding IrAlCentroNotificacionesCommand}" />

            <!-- Globo indicador rojo -->
            <Border BackgroundColor="Red"
                StrokeThickness="0"
                WidthRequest="16"
                HeightRequest="16"
                HorizontalOptions="End"
                VerticalOptions="Start"
                TranslationX="3"
                TranslationY="-3"
                IsVisible="{Binding TieneNotificaciones}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <Label Text="{Binding ConteoNotificaciones}"
                   TextColor="White"
                   FontSize="9"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!-- Overlay de carga -->
        <Grid BackgroundColor="{AppThemeBinding Light=#88000000, Dark=#B3000000}"
          HorizontalOptions="Fill"
          VerticalOptions="Fill"
          IsVisible="{Binding IsLoading}">

            <ActivityIndicator Color="{AppThemeBinding Light={StaticResource AzulOscuro}, Dark=#60A5FA}"
                           IsRunning="{Binding IsLoading}"
                           HeightRequest="{OnIdiom 70, Tablet=120}" />
        </Grid>
    </Grid>
</ContentPage>