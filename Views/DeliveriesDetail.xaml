<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="BatiaSuite.Views.DeliveriesDetail"
    Title="Listados Disponibles"
    BackgroundColor="#F5F5F5"
    Style="{StaticResource PageStyle}"
    xmlns:icons="clr-namespace:BatiaSuite.Resources.IconFonts"

    NavigationPage.HasNavigationBar="True"
    Shell.FlyoutBehavior="Disabled">
    <Grid>
        <ScrollView>
            <VerticalStackLayout>
            <Grid
                RowDefinitions="auto,auto,auto,auto,auto"
                VerticalOptions="CenterAndExpand"
                ColumnSpacing="5"
                RowSpacing="5"
                Margin="15,0,15,0">
                    
                    <Grid
                        Grid.Row="0"
                        RowDefinitions="auto">
                        <Frame
                            Grid.Row="0"
                            Margin="10,0,0,0"
                            Grid.Column="0"
                            BorderColor="Transparent"
                            HeightRequest="30"
                            CornerRadius="10"
                            Padding="0"
                            BackgroundColor="Transparent">
                            <Label
                                Text="{Binding ClienteEntry}"
                                FontFamily="MontBold"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                FontSize="18"
                                TextColor="#3775B5"
                                BackgroundColor="Transparent">
                            </Label>
                        </Frame>
                    </Grid>
                    <Frame
                    Grid.Row="1"
                    BackgroundColor="#4a92fe"
                    HeightRequest="35"
                    BorderColor="Transparent"
                    Padding="0"
                    CornerRadius="5">

                        <Grid
                        RowDefinitions="*"
                        ColumnDefinitions="*,*,*,*,*,*"
                        ColumnSpacing="5">

                            <Label
                            Grid.ColumnSpan="3"
                            Text="FOLIO"
                            FontSize="16"
                            TextColor="White"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            FontFamily="MontSemibold" />
                            <Label
                            Grid.ColumnSpan="5"
                            Grid.Column="1"
                            Text="TIPO"
                            FontSize="16"
                            TextColor="White"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            FontFamily="MontSemibold" />
                            <Label
                            Grid.Column="3"
                            Text=""
                            FontSize="16"
                            TextColor="White"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"
                            FontFamily="MontSemibold" />
                        </Grid>
                    </Frame>
                    <Frame
                    Grid.Row="2"
                    BackgroundColor="Transparent"
                    BorderColor="#3775B5"
                    MinimumHeightRequest="210"
                    MaximumHeightRequest="400"
                    Padding="10">  

                        <CollectionView
                        IsEnabled="{Binding IsDelivering}"
                        Opacity="{Binding IsDelivering, Converter={StaticResource BooleanToOpacityConverter}}"
                        x:Name="lisApp"
                        ItemsSource="{Binding ListApps}">
                            
                            <CollectionView.ItemsLayout>
                            <LinearItemsLayout
                                Orientation="Vertical"
                                ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                <Label
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Text="No hay listados disponibles">
                                </Label>
                            </CollectionView.EmptyView>
                        
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame
                                    Padding="10"
                                    CornerRadius="5"
                                    BackgroundColor="White">

                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Path=BindingContext.CommandListadoSelec, Source={x:Reference lisApp}}"
                                            CommandParameter="{Binding .}">
                                        </TapGestureRecognizer>
                                    </Frame.GestureRecognizers>

                                        <Grid
                                            RowDefinitions="*"
                                            ColumnDefinitions="*,*,*,*,*,*"
                                            ColumnSpacing="5">
                                            <Label
        Grid.Column="0"
        HorizontalTextAlignment="Center"
        VerticalTextAlignment="Center"
        Style="{StaticResource ContentLabelStyle}"
        Text="{x:Static icons:Icons.PaperList}"
        FontFamily="{x:Static icons:Icons.Family}"
        TextColor="#3775B5"

        FontSize="{OnIdiom 20, Tablet=60}"
        Margin="0, 10" />

                                            <Label
        Grid.Column="1"
        Grid.ColumnSpan="2"
        Text="{Binding idlistado}"
        FontSize="18"
        TextColor="#3775B5"
        HorizontalTextAlignment="Start"
        VerticalTextAlignment="Center"
        FontFamily="MontSemibold" />

                                            <Label
    Grid.Column="2"
     Grid.ColumnSpan="3"
    Text="{Binding tipo}"
    FontSize="15"
    TextColor="#3775B5"
    HorizontalTextAlignment="Center"
    VerticalTextAlignment="Center"
    FontFamily="MontBold" />

                                            <!--<Label
    Grid.Column="2"
    Text="{Binding inmueble}"
    FontSize="15"
    TextColor="#3775B5"
    HorizontalTextAlignment="Center"
    VerticalTextAlignment="Center"
    FontFamily="MontBold" />-->
                                            <Label
    Grid.Column="6"
    HorizontalTextAlignment="Center"
    VerticalTextAlignment="Center"
    Style="{StaticResource ContentLabelStyle}"
    Text="{x:Static icons:Icons.RightOpen}"
    FontFamily="{x:Static icons:Icons.Family}"
    TextColor="#3775B5"

    FontSize="{OnIdiom 35, Tablet=60}"
    Margin="0, 10" />
                                        </Grid>
                                    </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Frame>
            </Grid>
                <Button
                    HeightRequest="55"
                    Grid.Row="3"
                    Text="Iniciar entrega"
                    TextColor="White"
                    Margin="90,0,90,50"
                    BackgroundColor="ForestGreen"
                    ImageSource="handtruck.png"
                    ContentLayout="Right,10"
                    FontSize="18"
                    IsVisible="{Binding IsDelivering, Converter={StaticResource InvertedBoolConverter}}"
                    Command="{Binding IniciarEntregaCommand}">
                    <Button.Shadow>
                        <Shadow
                            Brush="Black"
                            Radius="8"
                            Opacity="0.3" />
                    </Button.Shadow>
                </Button>
                <Button
                    HeightRequest="50"
                    Grid.Row="5"
                    Text="Finalizar entrega"
                    TextColor="White"
                    Margin="70,0,70,50"
                    BackgroundColor="Red"
                    ImageSource="deliveriecomplete.png"
                    ContentLayout="Right,10" 
                    FontSize="18"
                    IsVisible="{Binding IsDelivering}"
                    Command="{Binding FinalizarEntregaCommand}">
                    <Button.Shadow>
                        <Shadow
                            Brush="Black"
                            Radius="8"
                            Opacity="0.3" />
                    </Button.Shadow>
                </Button>

                <Grid
                    BackgroundColor="Transparent"
                    RowDefinitions="auto, auto"
                    ColumnDefinitions="*,*"
                    Grid.Row="4"
                    Grid.ColumnSpan="2">
                    <!--LABEL COMENZAR-->
                    <Label
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Text="Ver ruta en:"
                        FontFamily="MontSemibold"
                        FontSize="20"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        Margin="0,30,0,20"
                    ></Label>
                    <!--ABRIR MAPS-->
                    <Button
                        VerticalOptions="End"
                        Grid.RowSpan="1"
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="10,0,10,00"
                        HeightRequest="80"
                        BackgroundColor="White"
                        Text="" 
                        TextColor="White"
                        ImageSource="googlemapsicon.png"
                        ContentLayout="Right,10" 
                        Command="{Binding AbrirGoogleMapsCommand}">
                        <Button.Shadow>
                            <Shadow
                                Brush="Black"
                                Radius="8"
                                Opacity="0.3" />
                        </Button.Shadow>
                    </Button>

                    <!--ABRIR WAZE-->
                    <Button 
                        Grid.RowSpan="1"
                        VerticalOptions="End"
                        HeightRequest="80"
                        Margin="10,0,10,00"
                        Grid.Row="1"
                        Grid.Column="1"
                        BackgroundColor="#38cefe"
                        Text="" 
                        TextColor="White"
                        ImageSource="wazeicon.png"
                        ContentLayout="Right,10" 
                        Command="{Binding AbrirWazeCommand}"
                        IsVisible="{Binding AvailableDeliveries}">
                        <Button.Shadow>
                            <Shadow
                                Brush="Black"
                                Radius="8"
                                Opacity="0.3" />
                        </Button.Shadow>
                    </Button>
                </Grid>
            </VerticalStackLayout>
    </ScrollView>
        <Grid
            RowDefinitions="*,*"
            BackgroundColor="#88000000"
            IsVisible="{Binding IsLoading}">
            <ActivityIndicator
                Grid.Row="0"
                VerticalOptions="End"
                Color="White"
                IsRunning="{Binding IsLoading}"
                HeightRequest="{OnIdiom 70, Tablet=120}"/>  
            <Label
                 VerticalOptions="Start"
                 HorizontalOptions="Center"
                 Grid.Row="1"
                 TextColor="White"
                 Text="{Binding TextLoading}"
            ></Label>
        </Grid>
    </Grid>
</ContentPage>