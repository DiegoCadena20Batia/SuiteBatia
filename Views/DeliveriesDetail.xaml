<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="BatiaSuite.Views.DeliveriesDetail"
    Title="Sucursales en Ruta"
    BackgroundColor="#F8F9FA"
    xmlns:icons="clr-namespace:BatiaSuite.Resources.IconFonts"
    Shell.FlyoutBehavior="Disabled">

    <Grid RowDefinitions="*, Auto">

        <!-- LISTADO DE SUCURSALES DE LA RUTA -->
        <CollectionView
    Grid.Row="0"
    x:Name="lisSucursales"
    ItemsSource="{Binding ListSucursales}"
    IsEnabled="{Binding IsDelivering}"
    Opacity="{Binding IsDelivering, Converter={StaticResource BooleanToOpacityConverter}}"
    Margin="16,10,16,0">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="8" Margin="0,10,0,16">
                    <Label
                Text="{Binding RutaEntry}"
                FontFamily="MontBold"
                FontSize="22"
                TextColor="#1A3B60" />
                    <Label
                Text="Selecciona una sucursal para navegar hacia ella o ver sus listados pendientes."
                FontFamily="MontRegular"
                FontSize="14"
                TextColor="#6C757D" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="0,50" Spacing="10">
                    <Label 
                Text="No hay sucursales registradas en esta ruta" 
                FontFamily="MontSemibold" 
                FontSize="16" 
                TextColor="#6C757D" 
                HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border 
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1"
                Stroke="#E9ECEF"
                BackgroundColor="White"
                Padding="16,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                        Command="{Binding Path=BindingContext.SucursalSelecCommand, Source={x:Reference lisSucursales}}"
                        CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.05" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="14" VerticalOptions="Center">

                            <Border 
                        Grid.Column="0"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#EEF4FA"
                        HeightRequest="44"
                        WidthRequest="44"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                                <Label
                            Text="{x:Static icons:Icons.Building}" 
                            FontFamily="{x:Static icons:Icons.Family}"
                            TextColor="#3775B5"
                            FontSize="20"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label
                            Text="{Binding Inmueble}"
                            FontSize="16"
                            TextColor="#1A3B60"
                            FontFamily="MontBold" />
                                
                                <Label
                            Text="{Binding Nomenclatura, StringFormat='Código Ruta: {0}'}"
                            FontSize="13"
                            TextColor="#6C757D"
                            FontFamily="MontRegular"
                            LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <Label
                        Grid.Column="2"
                        Text="{x:Static icons:Icons.RightOpen}"
                        FontFamily="{x:Static icons:Icons.Family}"
                        TextColor="#B0BCC7"
                        FontSize="20"
                        VerticalOptions="Center"
                        HorizontalOptions="End" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- PANEL INFERIOR FIJO: BOTONES DE RUTA -->
        <Border 
            Grid.Row="1"
            StrokeShape="RoundRectangle 24,24,0,0"
            StrokeThickness="0"
            BackgroundColor="White"
            Padding="20,16,20,24">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-4" Radius="10" Opacity="0.06" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="16">

                <!-- Iniciar Ruta / Entrega -->
                <Button
                    HeightRequest="52"
                    Text="Iniciar Ruta de Entregas"
                    TextColor="White"
                    BackgroundColor="#28A745"
                    ImageSource="handtruck.png"
                    ContentLayout="Right,12"
                    FontSize="16"
                    FontFamily="MontSemibold"
                    CornerRadius="12"
                    IsVisible="{Binding IsDelivering, Converter={StaticResource InvertedBoolConverter}}"
                    Command="{Binding IniciarEntregaCommand}">
                    <Button.Shadow>
                        <Shadow Brush="#28A745" Offset="0,4" Radius="6" Opacity="0.2" />
                    </Button.Shadow>
                </Button>

                <!-- Finalizar Ruta / Entrega -->
                <Button
                    HeightRequest="52"
                    Text="Finalizar Ruta de Entregas"
                    TextColor="White"
                    BackgroundColor="#DC3545"
                    ImageSource="deliveriecomplete.png"
                    ContentLayout="Right,12"
                    FontSize="16"
                    FontFamily="MontSemibold"
                    CornerRadius="12"
                    IsVisible="{Binding IsDelivering}"
                    Command="{Binding FinalizarEntregaCommand}">
                    <Button.Shadow>
                        <Shadow Brush="#DC3545" Offset="0,4" Radius="6" Opacity="0.2" />
                    </Button.Shadow>
                </Button>

                <!-- SECCIÓN NAVEGACIÓN GPS (Ruta Completa) -->
                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="Navegar a la siguiente sucursal en:"
                        FontFamily="MontSemibold"
                        TextColor="#495057"
                        FontSize="14"
                        HorizontalOptions="Center" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Button
                            Grid.Column="0"
                            HeightRequest="60"
                            BackgroundColor="#F8F9FA"
                            BorderColor="#E9ECEF"
                            BorderWidth="1"
                            CornerRadius="10"
                            ImageSource="googlemapsicon.png"
                            Command="{Binding AbrirGoogleMapsCommand}">
                            <Button.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.05" />
                            </Button.Shadow>
                        </Button>

                        <Button 
                            Grid.Column="1"
                            HeightRequest="60"
                            BackgroundColor="#EEF9FF"
                            BorderColor="#CDEBFF"
                            BorderWidth="1"
                            CornerRadius="10"
                            ImageSource="wazeicon.png"
                            Command="{Binding AbrirWazeCommand}"
                            IsVisible="{Binding AvailableDeliveries}">
                            <Button.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.05" />
                            </Button.Shadow>
                        </Button>
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- PANTALLA DE CARGA -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="2"
            RowDefinitions="*, *"
            BackgroundColor="#B3000000"
            IsVisible="{Binding IsLoading}">
            <ActivityIndicator Grid.Row="0" VerticalOptions="End" Color="White" IsRunning="{Binding IsLoading}" HeightRequest="60" WidthRequest="60"/>
            <Label Grid.Row="1" VerticalOptions="Start" HorizontalOptions="Center" TextColor="White" FontFamily="MontSemibold" FontSize="16" Margin="0,16,0,0" Text="{Binding TextLoading}" />
        </Grid>
    </Grid>
</ContentPage>