<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="BatiaSuite.Views.Deliveries"
    xmlns:viewmodels="clr-namespace:BatiaSuite.ViewModel"
    xmlns:icons="clr-namespace:BatiaSuite.Resources.IconFonts"
    Title="ENTREGAS"
    NavigationPage.HasNavigationBar="True" 
    Style="{StaticResource PageStyle}"
    Shell.FlyoutBehavior="Disabled">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EEF2FF" Offset="0.0" />
                <GradientStop Color="SkyBlue" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView VerticalOptions="CenterAndExpand">
            <VerticalStackLayout 
                Spacing="24" 
                Margin="24" 
                MaximumWidthRequest="460" 
                HorizontalOptions="FillAndExpand">

                <Border WidthRequest="70" 
                        HeightRequest="70" 
                        StrokeShape="RoundRectangle 35" 
                        BackgroundColor="#E0F2FE" 
                        HorizontalOptions="Center" 
                        StrokeThickness="0"
                        Margin="0,0,0,-10">
                    <Label Text="🚚" 
                           FontSize="32" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"/>
                </Border>

                <Border 
                    BackgroundColor="White"
                    StrokeThickness="1"
                    Stroke="#F1F5F9"
                    StrokeShape="RoundRectangle 24"
                    Padding="24, 32, 24, 32"
                    HeightRequest="500">
                    
                    <Border.Shadow>
                        <Shadow Brush="#0F172A" Offset="0,12" Radius="24" Opacity="0.08" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="24">

                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Label 
                                Text="Rutas para Entrega"
                                FontFamily="MontBold"
                                FontSize="22"
                                TextColor="#0F172A"
                                HorizontalOptions="Center" />
                            <Label 
                                Text="Selecciona la fecha y ruta para continuar"
                                FontFamily="MontRegular"
                                FontSize="12"
                                TextColor="#64748B"
                                HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

                            <VerticalStackLayout Grid.Column="0" Spacing="8">
                                <Label Text="Mes" FontFamily="MontSemibold" FontSize="13" TextColor="#334155" Margin="4,0" />
                                <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC" HeightRequest="52">
                                    <Grid ColumnDefinitions="35, *">
                                        <Label Grid.Column="0" Text="📅" FontSize="15" VerticalOptions="Center" HorizontalOptions="Center" Margin="5,0,0,0"/>
                                        <Picker
                                            x:Name="pkrMes"
                                            Grid.Column="1"
                                            Title="Mes"
                                            TitleColor="#94A3B8"
                                            FontFamily="MontRegular"
                                            FontSize="15"
                                            TextColor="#1E293B"
                                            HorizontalOptions="FillAndExpand"
                                            Margin="0,0,10,0"
                                            
                                            SelectedIndexChanged="pkrMes_SelectedIndexChanged"
                                            ItemsSource="{Binding MesList}"
                                            ItemDisplayBinding="{Binding mes}"
                                            SelectedItem="{Binding IdMesSelected}" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Label Text="Año" FontFamily="MontSemibold" FontSize="13" TextColor="#334155" Margin="4,0" />
                                <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC" HeightRequest="52">
                                    <Entry
                                        Text="{Binding Year}"
                                        TextColor="#1E293B"
                                        FontFamily="MontRegular"
                                        FontSize="15"
                                        Placeholder="AAAA"
                                        PlaceholderColor="#94A3B8"
                                        Keyboard="Numeric"
                                        MaxLength="4"
                                        ClearButtonVisibility="WhileEditing"
                                        VerticalOptions="Center"
                                        HorizontalTextAlignment="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>


                        <VerticalStackLayout Spacing="8" Margin="0,10,0,0">
                            <Label Text="Ruta" FontFamily="MontSemibold" FontSize="13" TextColor="#334155" Margin="4,0" />
                            <Border Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC" HeightRequest="52">
                                <Grid ColumnDefinitions="40, *">
                                    <Label Grid.Column="0" Text="👤" FontSize="16" VerticalOptions="Center" HorizontalOptions="Center" TextColor="#64748B"/>
                                    <Picker
                                        Grid.Column="1"
                                        Title="Selecciona la ruta..."
                                        TitleColor="#94A3B8"
                                        FontFamily="MontRegular"
                                        FontSize="15"
                                        TextColor="#1E293B"
                                        HorizontalOptions="FillAndExpand"
                                        Margin="0,0,10,0"
                                        ItemsSource="{Binding Rutas}"
                                        ItemDisplayBinding="{Binding Ruta}"
                                        SelectedItem="{Binding IdRutaSelected}" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>


                        <Button
                            Text="Cargar listados"
                            Command="{Binding RegisterCommand}"
                            FontFamily="MontSemibold"
                            TextColor="White"
                            BackgroundColor="#2563EB"
                            HeightRequest="54"
                            CornerRadius="14"
                            FontSize="16"
                            Margin="0,40,0,0">
                            <Button.Shadow>
                                <Shadow Brush="#2563EB" Offset="0,6" Radius="12" Opacity="0.35" />
                            </Button.Shadow>
                        </Button>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid 
            RowDefinitions="*,*" 
            BackgroundColor="#CC0F172A" 
            IsVisible="{Binding IsLoading}">

            <ActivityIndicator
                Grid.Row="0"
                VerticalOptions="End"
                Color="#38BDF8"
                IsRunning="{Binding IsLoading}"
                HeightRequest="{OnIdiom 60, Tablet=100}"/>

            <Label
                Grid.Row="1"
                VerticalOptions="Start"
                HorizontalOptions="Center"
                Margin="0,20,0,0"
                TextColor="White"
                FontFamily="MontMedium"
                FontSize="16"
                Text="{Binding TextLoading}" />
        </Grid>
    </Grid>
</ContentPage>